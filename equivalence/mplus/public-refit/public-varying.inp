TITLE: Matched twolevel LPA refit of public ex10.4 data (NOT CFA model);
DATA: FILE = ex104-lpa.dat;
VARIABLE:
 NAMES = y1-y5 clus id;
 USEVARIABLES = y1-y5;
 CLUSTER = clus;
 IDVARIABLE = id;
 WITHIN = y1-y5;
 CLASSES = cb(2) cw(2);
 BETWEEN = cb;
ANALYSIS:
 TYPE = TWOLEVEL MIXTURE;
 ESTIMATOR = ML;
 STARTS = 100 20;
 STITERATIONS = 30;
 STSEED = 20260917;
 MITERATIONS = 10000;
 LOGCRITERION = 0.00000001;
 RLOGCRITERION = 0.000000001;
 MCONVERGENCE = 0.000001;
MODEL:
 %WITHIN%
 %OVERALL%
 %BETWEEN%
 %OVERALL%
 cw#1 ON cb;
MODEL cw:
 %WITHIN%
 %cw#1%
 [y1-y5];
 y1-y5;
 %cw#2%
 [y1-y5];
 y1-y5;
OUTPUT: TECH1 TECH15 SVALUES;
SAVEDATA:
 FILE = public-varying-posteriors.dat;
 SAVE = CPROBABILITIES;
 FORMAT = F20.12;
 RESULTS = public-varying-results.dat;

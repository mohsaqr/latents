INPUT INSTRUCTIONS

  TITLE: Gaussian scalar group random intercept, fixed unit loadings;
  DATA: FILE = one-profile.dat;
  VARIABLE: NAMES = y1 y2 group;
    USEVARIABLES = y1 y2;
    CLUSTER = group;
  ANALYSIS: TYPE = TWOLEVEL;
    ESTIMATOR = ML;
    ITERATIONS = 10000;
    CONVERGENCE = 0.000000001;
    LOGCRITERION = 0.000000001;
    RLOGCRITERION = 0.000000001;
    MCONVERGENCE = 0.00000001;
    MITERATIONS = 10000;
  MODEL:
    %WITHIN%
    y1 y2;
    y1 WITH y2@0;
    %BETWEEN%
    b BY y1@1 y2@1;
    y1@0 y2@0;
    [y1 y2];
    [b@0];
    b;
  OUTPUT: TECH1;
  SAVEDATA: RESULTS = one-profile-results.dat;
    FILE = one-profile-saved.dat;
    FORMAT = F20.12;




//LG6.1//
version = 6.1
infile 'g06.dat'

model
title 'g06';
options
   maxthreads=all;
   algorithm
      tolerance=1e-010 emtolerance=1e-008 emiterations=5000 nriterations=500;
   startvalues
      seed=20261001 sets=20 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   quadrature nodes=50;
   missing excludeall;
   output
      parameters=first standarderrors profile estimatedvalues=model;
   outfile 'g06_posteriors.txt' classification keep id g;
variables
   groupid g;
   dependent y1 continuous;
   latent
      GClass group nominal 3,
      F1 group continuous;
equations
   GClass <- 1;
   F1 | GClass;
   y1 <- 1 + GClass + (1) F1;
   y1;
end model

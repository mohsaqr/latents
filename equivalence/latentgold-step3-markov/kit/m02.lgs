//LG6.1//
version = 6.1
infile 'm02.dat'

model
title 'm02';
options
   maxthreads=all;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261017 sets=20 tolerance=1e-005 iterations=100;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   step3 modal ml;
   output
      parameters=last standarderrors estimatedvalues;
variables
   caseid id;
   independent z;
   latent State nominal dynamic coding=last posterior=(post1 post2 post3);
equations
   State[=0] <- 1;
   State <- (~tra) 1 | State[-1] + (~tra) z | State[-1];
end model

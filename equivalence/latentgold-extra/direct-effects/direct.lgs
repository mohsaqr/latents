//LG6.1//
version = 6.1
infile 'direct.dat'

model
title 'direct';
options
   maxthreads=all;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261019 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors profile;
variables
   independent z numeric;
   dependent y1 continuous, y2 continuous, y3 continuous, y4 continuous;
   latent Cluster nominal 2;
equations
   Cluster <- 1;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y3 <- 1 + Cluster + z;
   y4 <- 1 + Cluster;
   y1 - y4 | Cluster;
end model

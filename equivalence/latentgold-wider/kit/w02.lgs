//LG6.1//
version = 6.1
infile 'w02.dat'

model
title 'w02';
options
   maxthreads=2;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261101 sets=50 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors=robust;
   outfile 'w02_posteriors.txt' classification keep id;
variables
   caseid id;
   samplingweight w rescale;
   dependent y1 continuous, y2 continuous;
   latent State nominal dynamic 2;
equations
   State[=0] <- 1;
   State <- 1 | State[-1];
   y1 <- 1 + State;
   y2 <- 1 + State;
   y1 | State;
   y2 | State;
end model

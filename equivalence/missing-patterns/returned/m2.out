INPUT INSTRUCTIONS

  TITLE: latents missing-pattern case m2;
  DATA: FILE = m2.dat;
  VARIABLE:
   NAMES = id y1 y2 y3;
   USEVARIABLES = y1 y2 y3;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(3);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 400 80;
   STITERATIONS = 50;
   STSEED = 20261017;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [y1 y2 y3];
   y1 y2 y3;
   %c#2%
   [y1 y2 y3];
   y1 y2 y3;
   %c#3%
   [y1 y2 y3];
   y1 y2 y3;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = m2-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = m2-results.dat;




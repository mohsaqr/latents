   STITERATIONS = 40;
   STSEED = 20262075;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
  OUTPUT: TECH11;




INPUT INSTRUCTIONS

  TITLE: latents VLMR eei_k2_05, 3 against 4 classes;
  DATA: FILE = eei_k2_05_k4.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4;
   USEVARIABLES = y1 y2 y3 y4;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(4);

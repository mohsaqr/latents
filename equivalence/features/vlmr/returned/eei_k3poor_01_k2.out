  TITLE: latents VLMR eei_k3poor_01, 1 against 2 classes;
  DATA: FILE = eei_k3poor_01_k2.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4;
   USEVARIABLES = y1 y2 y3 y4;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(2);

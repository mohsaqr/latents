INPUT INSTRUCTIONS

  TITLE: latents VLMR eei_small_03, 3 against 4 classes;
  DATA: FILE = eei_small_03_k4.dat;
  VARIABLE:
   NAMES = id y1 y2 y3;
   USEVARIABLES = y1 y2 y3;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(4);
  ANALYSIS:
   TYPE = MIXTURE;

INPUT INSTRUCTIONS

  TITLE: latents VLMR weights_03, 2 against 3 classes;
  DATA: FILE = weights_03_k3.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4 w;
   USEVARIABLES = y1 y2 y3 y4;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   WEIGHT = w;
   CLASSES = c(3);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = MLR;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20272053;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
  OUTPUT: TECH11;




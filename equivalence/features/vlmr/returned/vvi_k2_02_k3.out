INPUT INSTRUCTIONS

  TITLE: latents VLMR vvi_k2_02, 2 against 3 classes;
  DATA: FILE = vvi_k2_02_k3.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4;
   USEVARIABLES = y1 y2 y3 y4;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(3);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = MLR;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20267042;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   y1 y2 y3 y4;
   %c#2%
   y1 y2 y3 y4;
   %c#3%
   y1 y2 y3 y4;
  OUTPUT: TECH11;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.

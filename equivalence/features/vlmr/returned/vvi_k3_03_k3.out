INPUT INSTRUCTIONS

  TITLE: latents VLMR vvi_k3_03, 2 against 3 classes;
  DATA: FILE = vvi_k3_03_k3.dat;
  VARIABLE:
   NAMES = id y1 y2 y3;
   USEVARIABLES = y1 y2 y3;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(3);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = MLR;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20268053;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   y1 y2 y3;
   %c#2%
   y1 y2 y3;
   %c#3%
   y1 y2 y3;
  OUTPUT: TECH11;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.

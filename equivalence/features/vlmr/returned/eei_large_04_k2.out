INPUT INSTRUCTIONS

  TITLE: latents VLMR eei_large_04, 1 against 2 classes;
  DATA: FILE = eei_large_04_k2.dat;
  VARIABLE:
   NAMES = id y1 y2 y3;
   USEVARIABLES = y1 y2 y3;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(2);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = MLR;

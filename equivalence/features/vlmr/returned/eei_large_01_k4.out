INPUT INSTRUCTIONS

  TITLE: latents VLMR eei_large_01, 3 against 4 classes;
  DATA: FILE = eei_large_01_k4.dat;
  VARIABLE:
   NAMES = id y1 y2 y3;
   USEVARIABLES = y1 y2 y3;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(4);

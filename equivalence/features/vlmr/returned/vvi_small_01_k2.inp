TITLE: latents VLMR vvi_small_01, 1 against 2 classes;
DATA: FILE = vvi_small_01_k2.dat;
VARIABLE:
 NAMES = id y1 y2 y3;
 USEVARIABLES = y1 y2 y3;
 IDVARIABLE = id;
 MISSING = ALL(-999);
 CLASSES = c(2);
ANALYSIS:
 TYPE = MIXTURE;
 ESTIMATOR = MLR;
 STARTS = 200 40;
 STITERATIONS = 40;
 STSEED = 20274031;
 MITERATIONS = 10000;
 LOGCRITERION = 0.00000001;
 RLOGCRITERION = 0.000000001;
 MCONVERGENCE = 0.000001;
MODEL:
 %OVERALL%
 %c#1%
 y1 y2 y3;
 %c#2%
 y1 y2 y3;
OUTPUT: TECH11;

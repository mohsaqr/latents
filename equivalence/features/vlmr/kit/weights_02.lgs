//LG6.1//
version = 6.1
infile 'weights_02-lg.dat'

model
title 'weights_02';
options
   maxthreads=2;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20272042 sets=200 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors;
variables
   caseweight w;
   dependent y1 continuous, y2 continuous, y3 continuous, y4 continuous;
   latent Cluster nominal 1:4;
equations
   Cluster <- 1;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y3 <- 1 + Cluster;
   y4 <- 1 + Cluster;
end model

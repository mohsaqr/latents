//LG6.1//
version = 6.1
infile 'lca_k2_05-lg.dat'

model
title 'lca_k2_05';
options
   maxthreads=2;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20270075 sets=200 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors;
variables
   dependent u1 nominal, u2 nominal, u3 nominal, u4 nominal, u5 nominal;
   latent Cluster nominal 1:4;
equations
   Cluster <- 1;
   u1 <- 1 + Cluster;
   u2 <- 1 + Cluster;
   u3 <- 1 + Cluster;
   u4 <- 1 + Cluster;
   u5 <- 1 + Cluster;
end model

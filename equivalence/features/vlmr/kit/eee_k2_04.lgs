//LG6.1//
version = 6.1
infile 'eee_k2_04-lg.dat'

model
title 'eee_k2_04';
options
   maxthreads=2;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20269064 sets=200 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors;
variables
   dependent y1 continuous, y2 continuous, y3 continuous;
   latent Cluster nominal 1:4;
equations
   Cluster <- 1;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y3 <- 1 + Cluster;
   y1 <-> y2;
   y1 <-> y3;
   y2 <-> y3;
end model

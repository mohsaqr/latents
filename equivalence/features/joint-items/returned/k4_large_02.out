INPUT INSTRUCTIONS

  TITLE: latents joint items k4_large_02;
  DATA: FILE = k4_large_02.dat;
  VARIABLE:
   NAMES = id p1p2 u1 u2 u3 u4 u5;
   USEVARIABLES = p1p2 u1 u2 u3 u4 u5;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CATEGORICAL = u1 u2 u3 u4 u5;
   NOMINAL = p1p2;
   CLASSES = c(4);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 400 80;
   STITERATIONS = 40;
   STSEED = 20261020;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [u1$1 u2$1 u3$1 u4$1 u5$1];
   [p1p2#1 p1p2#2 p1p2#3];
   %c#2%
   [u1$1 u2$1 u3$1 u4$1 u5$1];
   [p1p2#1 p1p2#2 p1p2#3];
   %c#3%
   [u1$1 u2$1 u3$1 u4$1 u5$1];
   [p1p2#1 p1p2#2 p1p2#3];
   %c#4%
   [u1$1 u2$1 u3$1 u4$1 u5$1];
   [p1p2#1 p1p2#2 p1p2#3];
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = k4_large_02-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = k4_large_02-results.dat;




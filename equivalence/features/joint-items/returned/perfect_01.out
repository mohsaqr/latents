INPUT INSTRUCTIONS

  TITLE: latents joint items perfect_01;
  DATA: FILE = perfect_01.dat;
  VARIABLE:
   NAMES = id p1p2 u1 u2 u3;
   USEVARIABLES = p1p2 u1 u2 u3;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CATEGORICAL = u1 u2 u3;
   NOMINAL = p1p2;
   CLASSES = c(2);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 400 80;
   STITERATIONS = 40;
   STSEED = 20261020;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [u1$1 u2$1 u3$1];
   [p1p2#1 p1p2#2];
   %c#2%
   [u1$1 u2$1 u3$1];
   [p1p2#1 p1p2#2];
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = perfect_01-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = perfect_01-results.dat;




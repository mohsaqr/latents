   IDVARIABLE = id;
   MISSING = ALL(-999);
   CATEGORICAL = u1 u2 u3;
   NOMINAL = p1p2;
   CLASSES = c(2);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 400 80;
   STITERATIONS = 40;
   STSEED = 20261020;

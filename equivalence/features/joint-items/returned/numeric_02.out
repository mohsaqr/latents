   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [u1$1 u2$1 u3$1];
   [p1p2#1 p1p2#2 p1p2#3 p1p2#4 p1p2#5];
   %c#2%
   [u1$1 u2$1 u3$1];
   [p1p2#1 p1p2#2 p1p2#3 p1p2#4 p1p2#5];
  OUTPUT: TECH1;
  SAVEDATA:

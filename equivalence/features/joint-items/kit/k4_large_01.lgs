//LG6.1//
version = 6.1
infile 'k4_large_01-lg.dat'

model
title 'k4_large_01';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261020 sets=150 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing includeall;
   output
      parameters=first standarderrors profile estimatedvalues=model;
   outfile 'k4_large_01_posteriors.txt' classification keep id;
variables
   dependent p1 nominal, p2 nominal, u1 nominal, u2 nominal, u3 nominal, u4 nominal, u5 nominal;
   latent
      Cluster nominal 4;
equations
   Cluster <- 1;
   p1 <- 1 + Cluster;
   p2 <- 1 + Cluster;
   u1 <- 1 + Cluster;
   u2 <- 1 + Cluster;
   u3 <- 1 + Cluster;
   u4 <- 1 + Cluster;
   u5 <- 1 + Cluster;
   p1 <-> p2 | Cluster;
end model

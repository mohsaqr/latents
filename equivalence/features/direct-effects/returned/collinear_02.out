INPUT INSTRUCTIONS

  TITLE: latents direct effects collinear_02;
  DATA: FILE = collinear_02.dat;
  VARIABLE:
   NAMES = id z y1 y2 y3 y4;
   USEVARIABLES = y1 y2 y3 y4 z;
   IDVARIABLE = id;
   CLASSES = c(2);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   INFORMATION = OBSERVED;
   STARTS = 400 80;
   STITERATIONS = 40;
   STSEED = 20261020;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   y3 ON z;
   %c#1%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
   %c#2%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = collinear_02-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = collinear_02-results.dat;




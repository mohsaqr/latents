INPUT INSTRUCTIONS

  TITLE: latents direct effects k1_01;
  DATA: FILE = k1_01.dat;
  VARIABLE:
   NAMES = id z y1 y2 y3 y4;
   USEVARIABLES = y1 y2 y3 y4 z;
   IDVARIABLE = id;
   CLASSES = c(1);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   INFORMATION = OBSERVED;
   STARTS = 400 80;
   STITERATIONS = 40;
   STSEED = 20261020;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   y3 ON z;
   y1 ON z;
   Y3 WITH Y1@0;
   %c#1%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
   Y3 WITH Y1@0;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = k1_01-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = k1_01-results.dat;




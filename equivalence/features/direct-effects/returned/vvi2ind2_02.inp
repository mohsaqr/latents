TITLE: latents direct effects vvi2ind2_02;
DATA: FILE = vvi2ind2_02.dat;
VARIABLE:
 NAMES = id z y1 y2 y3 y4;
 USEVARIABLES = y1 y2 y3 y4 z;
 IDVARIABLE = id;
 CLASSES = c(2);
ANALYSIS:
 TYPE = MIXTURE;
 ESTIMATOR = ML;
 INFORMATION = OBSERVED;
 STARTS = 400 80;
 STITERATIONS = 40;
 STSEED = 20261020;
 MITERATIONS = 10000;
 LOGCRITERION = 0.00000001;
 RLOGCRITERION = 0.000000001;
 MCONVERGENCE = 0.000001;
MODEL:
 %OVERALL%
 y3 ON z;
 y1 ON z;
 Y3 WITH Y1@0;
 %c#1%
 [y1 y2 y3 y4];
 y1 y2 y3 y4;
 Y3 WITH Y1@0;
 %c#2%
 [y1 y2 y3 y4];
 y1 y2 y3 y4;
 Y3 WITH Y1@0;
OUTPUT: TECH1;
SAVEDATA:
 FILE = vvi2ind2_02-posteriors.dat;
 SAVE = CPROBABILITIES;
 FORMAT = F20.12;
 RESULTS = vvi2ind2_02-results.dat;

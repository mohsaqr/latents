//LG6.1//
version = 6.1
infile 'vvi2ind2_01-lg.dat'

model
title 'vvi2ind2_01';
options
   maxthreads=2;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261020 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors profile write='vvi2ind2_01_write.txt';
   outfile 'vvi2ind2_01_posteriors.txt' classification keep id;
variables
   independent z numeric;
   dependent y1 continuous, y2 continuous, y3 continuous, y4 continuous;
   latent Cluster nominal 2;
equations
   Cluster <- 1;
   y1 <- 1 | Cluster + z;
   y2 <- 1 | Cluster;
   y3 <- 1 | Cluster + z;
   y4 <- 1 | Cluster;
   y1 | Cluster;
   y2 | Cluster;
   y3 | Cluster;
   y4 | Cluster;
end model

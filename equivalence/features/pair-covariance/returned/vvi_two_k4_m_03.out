INPUT INSTRUCTIONS

  TITLE: latents pair covariance vvi_two_k4_m_03;
  DATA: FILE = vvi_two_k4_m_03.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4 y5;
   USEVARIABLES = y1 y2 y3 y4 y5;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(4);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 400 80;
   STITERATIONS = 40;
   STSEED = 20261020;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [y1 y2 y3 y4 y5];
   y1 y2 y3 y4 y5;
   y1 WITH y3;
   y2 WITH y5;
   %c#2%
   [y1 y2 y3 y4 y5];
   y1 y2 y3 y4 y5;
   y1 WITH y3;
   y2 WITH y5;
   %c#3%
   [y1 y2 y3 y4 y5];
   y1 y2 y3 y4 y5;
   y1 WITH y3;
   y2 WITH y5;
   %c#4%
   [y1 y2 y3 y4 y5];
   y1 y2 y3 y4 y5;
   y1 WITH y3;
   y2 WITH y5;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = vvi_two_k4_m_03-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = vvi_two_k4_m_03-results.dat;




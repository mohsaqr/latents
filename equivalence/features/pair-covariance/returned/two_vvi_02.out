INPUT INSTRUCTIONS

  TITLE: latents pair covariance two_vvi_02;
  DATA: FILE = two_vvi_02.dat;
  VARIABLE:
   NAMES = id y1 y2;
   USEVARIABLES = y1 y2;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(2);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20261020;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [y1 y2];
   y1 y2;
   y1 WITH y2;
   %c#2%
   [y1 y2];
   y1 y2;
   y1 WITH y2;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = two_vvi_02-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = two_vvi_02-results.dat;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.
   1 WARNING(S) FOUND IN THE INPUT INSTRUCTIONS




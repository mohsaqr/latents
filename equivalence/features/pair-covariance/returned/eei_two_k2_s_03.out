  DATA: FILE = eei_two_k2_s_03.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4;
   USEVARIABLES = y1 y2 y3 y4;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(2);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 200 40;
   STITERATIONS = 40;

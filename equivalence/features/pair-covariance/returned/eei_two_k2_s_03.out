   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   y1 WITH y2;
   y3 WITH y4;
   %c#1%
   [y1 y2 y3 y4];
   %c#2%
   [y1 y2 y3 y4];
  OUTPUT: TECH1;
  SAVEDATA:

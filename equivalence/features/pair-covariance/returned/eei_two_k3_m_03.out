INPUT INSTRUCTIONS

  TITLE: latents pair covariance eei_two_k3_m_03;
  DATA: FILE = eei_two_k3_m_03.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4 y5;
   USEVARIABLES = y1 y2 y3 y4 y5;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(3);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20261020;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   y1 WITH y2;
   y4 WITH y5;
   %c#1%
   [y1 y2 y3 y4 y5];
   %c#2%
   [y1 y2 y3 y4 y5];
   %c#3%
   [y1 y2 y3 y4 y5];
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = eei_two_k3_m_03-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = eei_two_k3_m_03-results.dat;




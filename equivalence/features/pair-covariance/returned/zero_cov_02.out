INPUT INSTRUCTIONS

  TITLE: latents pair covariance zero_cov_02;
  DATA: FILE = zero_cov_02.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4;
   USEVARIABLES = y1 y2 y3 y4;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(2);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20261020;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
   y1 WITH y2;
   %c#2%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
   y1 WITH y2;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = zero_cov_02-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = zero_cov_02-results.dat;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.
   1 WARNING(S) FOUND IN THE INPUT INSTRUCTIONS



latents pair covariance zero_cov_02;


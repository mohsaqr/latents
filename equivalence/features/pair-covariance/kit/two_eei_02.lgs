//LG6.1//
version = 6.1
infile 'two_eei_02-lg.dat'

model
title 'two_eei_02';
options
   maxthreads=2;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261020 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors profile write='two_eei_02_write.txt';
   outfile 'two_eei_02_posteriors.txt' classification keep id;
variables
   dependent y1 continuous, y2 continuous;
   latent
      Cluster nominal 2;
equations
   Cluster <- 1;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y1;
   y2;
   y1 <-> y2;
end model

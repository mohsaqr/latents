//LG6.1//
version = 6.1
infile 'vvi_two_k3_m_01-lg.dat'

model
title 'vvi_two_k3_m_01';
options
   maxthreads=2;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261020 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors profile write='vvi_two_k3_m_01_write.txt';
   outfile 'vvi_two_k3_m_01_posteriors.txt' classification keep id;
variables
   dependent y1 continuous, y2 continuous, y3 continuous, y4 continuous, y5 continuous;
   latent
      Cluster nominal 3;
equations
   Cluster <- 1;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y3 <- 1 + Cluster;
   y4 <- 1 + Cluster;
   y5 <- 1 + Cluster;
   y1 | Cluster;
   y2 | Cluster;
   y3 | Cluster;
   y4 | Cluster;
   y5 | Cluster;
   y1 <-> y2 | Cluster;
   y3 <-> y4 | Cluster;
end model

//LG6.1//
version = 6.1
infile 'pl_lca_k2_hi_01_s3-post.txt'

model
title 'pl_lca_k2_hi_01_s3_vr';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   step3 modal ml;
   output
      parameters=first standarderrors=robust profile estimatedvalues=model
      write='pl_lca_k2_hi_01_s3_vr.txt';
variables
   dependent y continuous;
   latent Cluster nominal posterior = ( Cluster#1 Cluster#2 );
equations
   y <- 1 + Cluster;
   y | Cluster;
end model

model
title 'pl_lca_k2_hi_01_s3_er';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   step3 modal ml;
   output
      parameters=first standarderrors=robust profile estimatedvalues=model
      write='pl_lca_k2_hi_01_s3_er.txt';
variables
   dependent y continuous;
   latent Cluster nominal posterior = ( Cluster#1 Cluster#2 );
equations
   y <- 1 + Cluster;
end model


//LG6.1//
version = 6.1
infile 'x_lpa_k2_lo_02-data.txt'

model
title 'x_lpa_k2_lo_02_vr';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   startvalues
      seed=20261020 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   step3 modal ml simultaneous;
   output
      parameters=first standarderrors=robust profile estimatedvalues=model
      write='x_lpa_k2_lo_02_vr.txt';
variables
   dependent y continuous;
   latent Cluster nominal posterior = ( Cluster#1 Cluster#2 );
equations
   y <- 1 + Cluster;
   y | Cluster;
end model

model
title 'x_lpa_k2_lo_02_er';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   startvalues
      seed=20261020 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   step3 modal ml simultaneous;
   output
      parameters=first standarderrors=robust profile estimatedvalues=model
      write='x_lpa_k2_lo_02_er.txt';
variables
   dependent y continuous;
   latent Cluster nominal posterior = ( Cluster#1 Cluster#2 );
equations
   y <- 1 + Cluster;
end model


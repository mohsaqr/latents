//LG6.1//
version = 6.1
infile 'pl_lca_k3_lo_01_s1-data.txt'

model
title 'pl_lca_k3_lo_01_s1';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   startvalues
      seed=20261020 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first profile;
   outfile 'pl_lca_k3_lo_01_s1_post.txt' classification keep id y;
variables
   dependent u1 nominal, u2 nominal, u3 nominal, u4 nominal, u5 nominal, u6 nominal;
   latent Cluster nominal 3;
equations
   Cluster <- 1;
   u1 <- 1 + Cluster;
   u2 <- 1 + Cluster;
   u3 <- 1 + Cluster;
   u4 <- 1 + Cluster;
   u5 <- 1 + Cluster;
   u6 <- 1 + Cluster;
end model

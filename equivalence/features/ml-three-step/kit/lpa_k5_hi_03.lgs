//LG6.1//
version = 6.1
infile 'lpa_k5_hi_03-data.txt'

model
title 'lpa_k5_hi_03_vr';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   step3 modal ml;
   output
      parameters=first standarderrors=robust profile estimatedvalues=model
      write='lpa_k5_hi_03_vr.txt';
variables
   dependent y continuous;
   latent Cluster nominal posterior = ( Cluster#1 Cluster#2 Cluster#3 Cluster#4 Cluster#5 );
equations
   y <- 1 + Cluster;
   y | Cluster;
end model


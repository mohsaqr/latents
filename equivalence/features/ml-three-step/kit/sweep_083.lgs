//LG6.1//
version = 6.1
infile 'sweep_083-data.txt'

model
title 'sweep_083_vr';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   step3 modal ml;
   output
      parameters=first standarderrors=robust profile estimatedvalues=model
      write='sweep_083_vr.txt';
variables
   dependent y continuous;
   latent Cluster nominal posterior = ( Cluster#1 Cluster#2 Cluster#3 Cluster#4 );
equations
   y <- 1 + Cluster;
   y | Cluster;
end model

model
title 'sweep_083_er';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   step3 modal ml;
   output
      parameters=first standarderrors=robust profile estimatedvalues=model
      write='sweep_083_er.txt';
variables
   dependent y continuous;
   latent Cluster nominal posterior = ( Cluster#1 Cluster#2 Cluster#3 Cluster#4 );
equations
   y <- 1 + Cluster;
end model


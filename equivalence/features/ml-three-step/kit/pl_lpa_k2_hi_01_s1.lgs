//LG6.1//
version = 6.1
infile 'pl_lpa_k2_hi_01_s1-data.txt'

model
title 'pl_lpa_k2_hi_01_s1';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=10000 nriterations=1000;
   startvalues
      seed=20261020 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first profile;
   outfile 'pl_lpa_k2_hi_01_s1_post.txt' classification keep id y;
variables
   dependent y1 continuous, y2 continuous, y3 continuous, y4 continuous;
   latent Cluster nominal 2;
equations
   Cluster <- 1;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y3 <- 1 + Cluster;
   y4 <- 1 + Cluster;
   y1 | Cluster;
   y2 | Cluster;
   y3 | Cluster;
   y4 | Cluster;
end model

//LG6.1//
version = 6.1
infile 'd02.dat'

model
title 'd02_proportional';
options
   maxthreads=all;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261101 sets=20 tolerance=1e-005 iterations=100;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   step3 proportional none;
   output
      parameters=first standarderrors profile estimatedvalues=model;
variables
   dependent distal nominal coding=first;
   latent Cluster nominal coding=first posterior = ( post1 post2 post3 );
equations
   Cluster <- 1;
   distal <- 1 + Cluster;
end model

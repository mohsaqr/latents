INPUT INSTRUCTIONS

  TITLE:	this is an example of a hidden Markov
  	model with four time points
  DATA:	FILE IS ex8.12.dat;
  VARIABLE:	NAMES ARE u1-u4 c1-c4;
  	USEV = u1-u4;
  	CATEGORICAL = u1-u4;
  	CLASSES = c1(2) c2(2) c3(2) c4(2);
  ANALYSIS:	TYPE = MIXTURE;
  MODEL:
  	%OVERALL%
  	[c2#1-c4#1]  (1);
  	c4 ON c3 (2);	
  	c3 ON c2 (2);
  	c2 ON c1 (2);
  MODEL c1:
  	%c1#1%
  	[u1$1] (3);
  	%c1#2%
  	[u1$1] (4);
  MODEL c2:
  	%c2#1%
  	[u2$1] (3);
  	%c2#2%
  	[u2$1] (4);
  MODEL c3:
  	%c3#1%
  	[u3$1] (3);
  	%c3#2%
  	[u3$1] (4);
  MODEL c4:
  	%c4#1%
  	[u4$1] (3);
  	%c4#2%
  	[u4$1] (4);
  OUTPUT:	TECH1 TECH8;




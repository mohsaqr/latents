//LG6.1//
version = 6.1
infile 'g03.dat'

model
title 'g03';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261201 sets=50 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors;
   outfile 'g03_posteriors.txt' classification keep id;
variables
   dependent y1 continuous, y2 continuous, y3 continuous, y4 continuous, y5 continuous;
   latent Class nominal 2 coding=first, F1 continuous, F2 continuous;
equations
   Class <- 1;
   F1;
   (0) F2;
   (0) F1 <-> F2;
   F1 <- 1 | Class;
   F2 <- 1 | Class;
   y1 <- (1) F1 + (0) F2;
   y2 <- (1) F1 + (1) F2;
   y3 <- (1) F1 + (2) F2;
   y4 <- (1) F1 + (3) F2;
   y5 <- (1) F1 + (4) F2;
   (e) y1 | Class;
   (e) y2 | Class;
   (e) y3 | Class;
   (e) y4 | Class;
   (e) y5 | Class;
end model

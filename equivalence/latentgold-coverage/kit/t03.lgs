//LG6.1//
version = 6.1
infile 't03.dat'

model
title 't03';
options
   maxthreads=1;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261201 sets=50 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors;
   outfile 't03_posteriors.txt' classification keep id;
variables
   caseid id;
   dependent y1 continuous, y2 continuous;
   independent z;
   latent State nominal dynamic 2 coding=first;
equations
   State[=0] <- 1;
   State <- 1 | State[-1] + z | State[-1];
   y1 <- 1 + State;
   y2 <- 1 + State;
   y1 | State;
   y2 | State;
end model

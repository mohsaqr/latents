//LG6.1//
version = 6.1
infile 'o04.dat'

model
title 'o04';
options
   maxthreads=all;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261001 sets=50 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors profile;
   outfile 'o04_posteriors.txt' classification keep id;
variables
   dependent o1 ordinal, o2 ordinal, o3 ordinal;
   latent Cluster nominal 2;
equations
   Cluster <- 1;
   o1 <- 1 + Cluster;
   o2 <- 1 + Cluster;
   o3 <- 1 + Cluster;
end model

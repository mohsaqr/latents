   [y1 y2 y3 y4];
   y1 y2 y3 y4;
   %c#4%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
  SAVEDATA:
   RESULTS = lpa_k3_high_n300_r1-k4-results.dat;




INPUT INSTRUCTIONS

  TITLE: latents Monte Carlo equivalence lpa_vvv_07;
  DATA: FILE = lpa_vvv_07.dat;
  VARIABLE:
   NAMES = id y1 y2 y3;
   USEVARIABLES = y1 y2 y3;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(2);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20261017;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [y1 y2 y3];
   y1 y2 y3;
   y1 WITH y2 y3;
   y2 WITH y3;
   %c#2%
   [y1 y2 y3];
   y1 y2 y3;
   y1 WITH y2 y3;
   y2 WITH y3;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = lpa_vvv_07-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = lpa_vvv_07-results.dat;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.
   1 WARNING(S) FOUND IN THE INPUT INSTRUCTIONS




Mplus VERSION 9 DEMO (Mac)
MUTHEN & MUTHEN
10/17/2026  11:48 PM

INPUT INSTRUCTIONS

  TITLE: latents Monte Carlo equivalence ml_lpa_12;
  DATA: FILE = ml_lpa_12.dat;
  VARIABLE:
   NAMES = id g y1 y2 y3;
   USEVARIABLES = y1 y2 y3;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLUSTER = g;
   WITHIN = y1 y2 y3;
   CLASSES = cb(2) cw(2);
   BETWEEN = cb;
  ANALYSIS:
   TYPE = TWOLEVEL MIXTURE;
   ESTIMATOR = ML;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20261017;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %WITHIN%
   %OVERALL%
   %BETWEEN%
   %OVERALL%
   cw#1 ON cb;
  MODEL cw:
   %WITHIN%
   %cw#1%
   [y1 y2 y3];
   y1 y2 y3;
   %cw#2%
   [y1 y2 y3];
   y1 y2 y3;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = ml_lpa_12-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = ml_lpa_12-results.dat;




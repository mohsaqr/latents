  TITLE: latents Monte Carlo equivalence lca_binary_01;
  DATA: FILE = lca_binary_01.dat;
  VARIABLE:
   NAMES = id u1 u2 u3 u4 u5 u6;
   USEVARIABLES = u1 u2 u3 u4 u5 u6;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CATEGORICAL = u1 u2 u3 u4 u5 u6;
   CLASSES = c(3);

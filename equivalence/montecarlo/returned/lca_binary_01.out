   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20261017;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [u1$1 u2$1 u3$1 u4$1 u5$1 u6$1];
   %c#2%
   [u1$1 u2$1 u3$1 u4$1 u5$1 u6$1];
   %c#3%
   [u1$1 u2$1 u3$1 u4$1 u5$1 u6$1];
  OUTPUT: TECH1;
  SAVEDATA:

INPUT INSTRUCTIONS

  TITLE: latents Monte Carlo equivalence lpa_missing_14;
  DATA: FILE = lpa_missing_14.dat;
  VARIABLE:
   NAMES = id y1 y2 y3 y4;
   USEVARIABLES = y1 y2 y3 y4;
   IDVARIABLE = id;
   MISSING = ALL(-999);
   CLASSES = c(3);
  ANALYSIS:
   TYPE = MIXTURE;
   ESTIMATOR = ML;
   STARTS = 200 40;
   STITERATIONS = 40;
   STSEED = 20261017;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %OVERALL%
   %c#1%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
   %c#2%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
   %c#3%
   [y1 y2 y3 y4];
   y1 y2 y3 y4;
  OUTPUT: TECH1;
  SAVEDATA:
   FILE = lpa_missing_14-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = lpa_missing_14-results.dat;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.
*** WARNING
  Data set contains cases with missing on all variables.
  These cases were not included in the analysis.
  Number of cases with missing on all variables:  30

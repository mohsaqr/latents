TITLE: latents Monte Carlo equivalence lpa_covariates_09;
DATA: FILE = lpa_covariates_09.dat;
VARIABLE:
 NAMES = id x1 x2 y1 y2 y3;
 USEVARIABLES = y1 y2 y3 x1 x2;
 IDVARIABLE = id;
 MISSING = ALL(-999);
 CLASSES = c(2);
ANALYSIS:
 TYPE = MIXTURE;
 ESTIMATOR = ML;
 STARTS = 200 40;
 STITERATIONS = 40;
 STSEED = 20261017;
 MITERATIONS = 10000;
 LOGCRITERION = 0.00000001;
 RLOGCRITERION = 0.000000001;
 MCONVERGENCE = 0.000001;
MODEL:
 %OVERALL%
 c ON x1 x2;
 %c#1%
 [y1 y2 y3];
 y1 y2 y3;
 %c#2%
 [y1 y2 y3];
 y1 y2 y3;
OUTPUT: TECH1;
SAVEDATA:
 FILE = lpa_covariates_09-posteriors.dat;
 SAVE = CPROBABILITIES;
 FORMAT = F20.12;
 RESULTS = lpa_covariates_09-results.dat;

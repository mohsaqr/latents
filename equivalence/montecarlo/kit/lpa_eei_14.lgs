//LG6.1//
version = 6.1
infile 'lpa_eei_14-lg.dat'

model
title 'lpa_eei_14';
options
   maxthreads=all;
   algorithm
      tolerance=1e-010 emtolerance=1e-008 emiterations=5000 nriterations=500;
   startvalues
      seed=20261017 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing includeall;
   output
      parameters=first profile probmeans=posterior;
   outfile 'lpa_eei_14_posteriors.txt' classification keep id;
variables
   dependent y1 continuous, y2 continuous, y3 continuous, y4 continuous;
   latent
      Cluster nominal 3;
equations
   Cluster <- 1;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y3 <- 1 + Cluster;
   y4 <- 1 + Cluster;
end model

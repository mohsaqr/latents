//LG6.1//
version = 6.1
infile 'ml_lca_01-lg.dat'

model
title 'ml_lca_01';
options
   maxthreads=all;
   algorithm
      tolerance=1e-010 emtolerance=1e-008 emiterations=5000 nriterations=500;
   startvalues
      seed=20261017 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing includeall;
   output
      parameters=first profile probmeans=posterior;
   outfile 'ml_lca_01_posteriors.txt' classification keep id g;
variables
   groupid g;
   dependent u1 nominal, u2 nominal, u3 nominal, u4 nominal, u5 nominal;
   latent
      GClass group nominal 2,
      Cluster nominal 2;
equations
   GClass <- 1;
   Cluster <- 1 + GClass;
   u1 <- 1 + Cluster;
   u2 <- 1 + Cluster;
   u3 <- 1 + Cluster;
   u4 <- 1 + Cluster;
   u5 <- 1 + Cluster;
end model

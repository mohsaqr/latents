//LG6.1//
version = 6.1
infile 'lca_binary_14-lg.dat'

model
title 'lca_binary_14';
options
   maxthreads=all;
   algorithm
      tolerance=1e-010 emtolerance=1e-008 emiterations=5000 nriterations=500;
   startvalues
      seed=20261017 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing includeall;
   output
      parameters=first profile probmeans=posterior;
   outfile 'lca_binary_14_posteriors.txt' classification keep id;
variables
   dependent u1 nominal, u2 nominal, u3 nominal, u4 nominal, u5 nominal, u6 nominal;
   latent
      Cluster nominal 3;
equations
   Cluster <- 1;
   u1 <- 1 + Cluster;
   u2 <- 1 + Cluster;
   u3 <- 1 + Cluster;
   u4 <- 1 + Cluster;
   u5 <- 1 + Cluster;
   u6 <- 1 + Cluster;
end model

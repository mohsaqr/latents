//LG6.1//
version = 6.1
infile 's02_step1.dat'

model
title 's02_step1';
options
   maxthreads=all;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261101 sets=20 tolerance=1e-005 iterations=100;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors profile estimatedvalues=model writeclassificationerrors='s02_lg_errors.txt';
   outfile 's02_lg_classes.txt' classification keep id;
variables
   caseid id;
   dependent y1 continuous, y2 continuous, y3 continuous;
   latent Cluster nominal 3;
equations
   Cluster <- 1;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y3 <- 1 + Cluster;
   y1 | Cluster;
   y2 | Cluster;
   y3 | Cluster;
end model

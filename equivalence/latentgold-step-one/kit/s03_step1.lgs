//LG6.1//
version = 6.1
infile 's03_step1.dat'

model
title 's03_step1';
options
   maxthreads=all;
   algorithm
      tolerance=1e-012 emtolerance=1e-010 emiterations=5000 nriterations=500;
   startvalues
      seed=20261101 sets=20 tolerance=1e-005 iterations=100;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors profile estimatedvalues=model writeclassificationerrors='s03_lg_errors.txt';
   outfile 's03_lg_classes.txt' classification keep id;
variables
   caseid id;
   dependent u1 nominal, u2 nominal, u3 nominal, u4 nominal, u5 nominal, u6 nominal;
   latent Cluster nominal 3;
equations
   Cluster <- 1;
   u1 <- 1 + Cluster;
   u2 <- 1 + Cluster;
   u3 <- 1 + Cluster;
   u4 <- 1 + Cluster;
   u5 <- 1 + Cluster;
   u6 <- 1 + Cluster;
end model

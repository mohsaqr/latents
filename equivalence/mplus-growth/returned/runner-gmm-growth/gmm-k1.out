INPUT INSTRUCTIONS

  TITLE: Mplus Demo v9 runner comparison - growth mixture K = 1, linear;
    class-specific G_k and time-invariant sigma2_k (fitMixtureGrowth);
    SYNTHETIC seeded data from validation/mplus/runner-mixtures-data.R. NOT a UG example.;
  DATA: FILE IS gmm.dat;
  VARIABLE:
    NAMES ARE y1-y4;
    CLASSES = c(1);
  ANALYSIS:
    TYPE = MIXTURE;
    STARTS = 400 100;
    STITERATIONS = 20;
    PROCESS = 1;
  MODEL:
    %OVERALL%
    i s | y1@0 y2@1 y3@2 y4@3;
    %c#1%
    i s;
    i WITH s;
    y1-y4 (r1);




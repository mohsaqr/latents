//LG6.1//
version = 6.1
infile 'c01.dat'

model
title 'c02_continuous_equal';
options
   maxthreads=all;
   algorithm
      tolerance=1e-010 emtolerance=1e-008 emiterations=5000 nriterations=500;
   startvalues
      seed=20260922 sets=100 tolerance=1e-005 iterations=250;
   bayes
      categorical=0 variances=0 latent=0 poisson=0;
   missing excludeall;
   output
      parameters=first standarderrors profile probmeans=posterior
      bivariateresiduals estimatedvalues=model;
   outfile 'c02_continuous_equal_posteriors.txt' classification keep id g;
variables
   groupid g;
   dependent y1 continuous, y2 continuous, y3 continuous;
   latent
      GClass group nominal 2,
      Cluster nominal 2;
equations
   GClass <- 1;
   Cluster <- 1 + GClass;
   y1 <- 1 + Cluster;
   y2 <- 1 + Cluster;
   y3 <- 1 + Cluster;
end model


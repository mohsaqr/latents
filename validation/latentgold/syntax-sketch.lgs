// UNVERIFIED SKETCH. Not run, not syntax-checked against Latent GOLD 6.1.
// It records which models to fit; confirm the keywords against the manual.

// ---- model 1: two-level cluster model with bivariate residuals -------------
options
   algorithm tolerance=1e-8 emtolerance=0.01 emiterations=500 nriterations=50;
   startvalues seed=1 sets=32 tolerance=1e-5 iterations=100;
   output parameters=effect standarderrors profile probmeans=posterior
          bivariateresiduals estimatedvalues iterationdetails;
variables
   caseid id;
   groupid group;
   dependent y1 continuous, y2 continuous, y3 continuous;
   latent GClass group nominal 2, Class nominal 2;
equations
   GClass <- 1;
   Class  <- 1 | GClass;
   y1     <- 1 | Class;
   y2     <- 1 | Class;
   y3     <- 1 | Class;
   y1     | Class;              // profile-specific residual variances
   y2     | Class;
   y3     | Class;

// ---- model 2: single-level classes, then Step-3 ----------------------------
// Fit the 2-class measurement model on y1 and y2, save class assignments and
// posteriors, then run Step-3 twice:
//   (a) dependent = distal, with the BCH correction;
//   (b) covariate = x predicting class membership.

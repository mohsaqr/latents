Mplus VERSION 9 DEMO (Mac)
MUTHEN & MUTHEN
09/17/2026  10:21 PM

INPUT INSTRUCTIONS

  TITLE: Native R mllpa validation, synthetic data, two discrete levels;
  DATA: FILE = synthetic.dat;
  VARIABLE:
   NAMES = y1 y2 clus id;
   USEVARIABLES = y1 y2;
   CLUSTER = clus;
   IDVARIABLE = id;
   WITHIN = y1 y2;
   CLASSES = cb(2) cw(2);
   BETWEEN = cb;
  ANALYSIS:
   TYPE = TWOLEVEL MIXTURE;
   ESTIMATOR = ML;
   STARTS = 100 20;
   STITERATIONS = 30;
   STSEED = 20260917;
   MITERATIONS = 10000;
   LOGCRITERION = 0.00000001;
   RLOGCRITERION = 0.000000001;
   MCONVERGENCE = 0.000001;
  MODEL:
   %WITHIN%
   %OVERALL%
   %BETWEEN%
   %OVERALL%
   cw#1 ON cb;
  MODEL cw:
   %WITHIN%
   %cw#1%
   [y1 y2];
   y1 (v1); y2 (v2);
   %cw#2%
   [y1 y2];
   y1 (v1); y2 (v2);
  OUTPUT: TECH1 TECH15 SVALUES;
  SAVEDATA:
   FILE = equal-posteriors.dat;
   SAVE = CPROBABILITIES;
   FORMAT = F20.12;
   RESULTS = equal-results.dat;



*** WARNING in MODEL command
  Variable is uncorrelated with all other variables within class: Y1
*** WARNING in MODEL command
  Variable is uncorrelated with all other variables within class: Y2
*** WARNING in MODEL command
  At least one variable is uncorrelated with all other variables within class.
  Check that this is what is intended.

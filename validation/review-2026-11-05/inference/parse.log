        fit <- get(label)
        a <- capture(three_step(fit, d, "y"))
        b <- capture(three_step(fit, d, "y", step_one = "estimated"))
        if (!is.null(a$value) && !is.null(b$value)) {
            print(data.frame(fit = label, fixed = a$value$standard_error, 
                estimated = b$value$standard_error, ratio = b$value$standard_error/a$value$standard_error))
            cat("vcov dims", dim(vcov(fit, scale = "unconstrained")), 
                "step_one", attr(b$value, "step_one"), "warnings", 
                length(b$warnings), "\n")
        }
    })), cat("\nD staged bootstrap with foreign measurement\n"), 
    set.seed(15054), G <- 50L, m <- 6L, g <- rep(seq_len(G), 
        each = m), make_data <- function(shift = 0) {
        h <- sample(1:2, G, TRUE)
        k <- 1L + rbinom(G * m, 1, c(0.2, 0.8)[h[g]])
        data.frame(g = g, a = shift + rnorm(G * m, c(-1.5, 1.5)[k]), 
            b = rnorm(G * m, c(-1, 1)[k]), c = rnorm(G * m, c(-1, 
                1)[k]))
    }, foreign <- make_data(3), current <- make_data(), measurement <- multilpa(foreign, 
        c("a", "b", "c"), "g", n_profiles = 2, n_group_classes = 1, 
        n_starts = 3, seed = 1), staged <- fit_staged(current, 
        c("a", "b", "c"), "g", n_profiles = 2, n_group_classes = 2, 
        measurement = measurement, n_starts = 3, seed = 1), boot <- capture(parameter_inference(staged, 
        method = "bootstrap", iter = 16, n_starts = 2, seed = 1)), 
    if (!is.null(boot$value)) {
        b <- boot$value
        print(b[b$parameter == "mean", c("outcome", "term", "estimate", 
            "conf_low", "conf_high")])
        cat("outside intervals", sum(b$estimate < b$conf_low | 
            b$estimate > b$conf_high), "of", nrow(b), "valid", 
            attr(b, "n_valid"), "\n")
        replicates <- as.data.frame(b, what = "replicates")
        cat("bootstrap identity control, replicate rows", nrow(replicates), 
            "\n")
        altered <- b[rev(seq_len(nrow(b))), , drop = FALSE]
        refused <- capture(as.data.frame(altered, what = "replicates"))
        stopifnot(is.null(refused$value), nrow(replicates) == 
            attr(b, "n_valid") * nrow(b))
    }, cat("\nE r3step separation\n"), set.seed(15055), n <- 400L, 
    k <- 1L + rbinom(n, 1, 0.5), d <- data.frame(a = rnorm(n, 
        c(-2.5, 2.5)[k]), b = rnorm(n, c(-2.5, 2.5)[k])), fit <- lpa(d, 
        c("a", "b"), n_profiles = 2, n_starts = 3, seed = 1), 
    d$x <- ifelse(fit$subject_profiles == 1L, 1, -1) * 0.6 + 
        rnorm(n, 0, 0.2), invisible(lapply(c("robust", "observed"), 
        function(type) {
            r <- capture(r3step(fit, d, "x", vcov_type = type))
            cat("vcov_type", type, "warnings", length(r$warnings), 
                "\n")
            if (!is.null(r$value)) print(as.data.frame(r$value)[, 
                c("term", "estimate", "standard_error", "p_value")])
        })))
PARSE_OK

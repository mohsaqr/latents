expression(Sys.setenv(VECLIB_MAXIMUM_THREADS = "1", OMP_NUM_THREADS = "1", 
    NOT_CRAN = "true"), pkgload::load_all(".", quiet = TRUE), 
    cat("VERSION", as.character(packageVersion("latents")), "\n"), 
    capture <- function(expr) {
        warnings <- character()
        value <- withCallingHandlers(tryCatch(expr, error = function(e) {
            cat("ERROR", class(e)[1L], conditionMessage(e), "\n")
            NULL
        }), warning = function(w) {
            warnings <<- c(warnings, paste(class(w)[1L], conditionMessage(w)))
            invokeRestart("muffleWarning")
        })
        if (length(warnings)) 
            cat("WARNINGS", paste(warnings, collapse = " | "), 
                "\n")
        list(value = value, warnings = warnings)
    }, cat("\nA held categorical conditional inference\n"), set.seed(15051), 
    n <- 500L, z <- rnorm(n), k <- 1L + rbinom(n, 1, plogis(0.2 + 
        0.8 * z)), d <- data.frame(g = seq_len(n), z = z), vars <- paste0("u", 
        1:5), d[vars] <- lapply(vars, function(v) factor(ifelse(runif(n) < 
        c(0.75, 0.3)[k], "yes", "no"))), str(d), base <- multilpa(d, 
        vars, "g", n_profiles = 2, n_group_classes = 1, categorical = vars, 
        n_starts = 3, seed = 1, tol = 1e-10), held <- multilpa(d, 
        vars, "g", n_profiles = 2, n_group_classes = 1, categorical = vars, 
        profile_covariates = "z", start = starting_values(base, 

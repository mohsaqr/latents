        m, c(-1.3, 1.3)[k]), b = rnorm(G * m, c(1, -1)[k]), c = rnorm(G * 
        m, c(-0.5, 0.5)[k])), args <- list(data = d, vars = c("a", 
        "b", "c"), id = "g", n_profiles = 2, n_group_classes = 2, 
        n_starts = 3, seed = 1, tol = 1e-10), plain <- do.call(multilpa, 
        args), grand <- do.call(multilpa, c(args, list(centering = "grand"))), 
    invisible(lapply(c("observed", "robust", "opg"), function(type) {
        p <- capture(parameter_inference(plain, vcov_type = type))$value
        q <- capture(parameter_inference(grand, vcov_type = type))$value
        if (is.null(p) || is.null(q)) return(NULL)
        keep <- p$parameter == "probability"
        print(data.frame(type = type, outcome = p$outcome[keep], 
            term = p$term[keep], plain = p$standard_error[keep], 
            grand = q$standard_error[keep], ratio = q$standard_error[keep]/p$standard_error[keep]))
    })), cat("\nC staged three-step correction\n"), set.seed(15053), 
    G <- 100L, m <- 10L, g <- rep(seq_len(G), each = m), h <- rep(1:2, 
        length.out = G), k <- 1L + rbinom(G * m, 1, c(0.3, 0.7)[h[g]]), 
    d <- data.frame(g = g, a = rnorm(G * m, c(-0.8, 0.8)[k]), 
        b = rnorm(G * m, c(-0.7, 0.7)[k]), c = rnorm(G * m, c(0.7, 
            -0.7)[k]), y = rnorm(G * m, c(0, 1)[k])), joint <- multilpa(d, 
        c("a", "b", "c"), "g", n_profiles = 2, n_group_classes = 2, 
        n_starts = 3, seed = 1, tol = 1e-10), staged <- fit_staged(d, 

        seed = 1, tol = 1e-10), rp <- held$response_probabilities, 
    ld <- vapply(1:2, function(kk) Reduce(`+`, lapply(vars, function(v) log(rp[[v]][kk, 
        as.character(d[[v]])]))), numeric(n)), ll <- function(b) {
        p <- plogis(b[1L] + b[2L] * d$z)
        sum(log(p * exp(ld[, 1L]) + (1 - p) * exp(ld[, 2L])))
    }, hand <- sqrt(diag(solve(-numDeriv::hessian(ll, as.vector(held$profile_coefficients))))), 
    actual <- parameter_inference(held)$standard_error, print(data.frame(actual = actual, 
        independent = hand, ratio = actual/hand)), cat("n_parameters", 
        held$n_parameters, "vcov dims", dim(vcov(held, scale = "unconstrained")), 
        "\n"), stopifnot(max(abs(actual/hand - 1)) < 1e-04, nrow(vcov(held, 
        scale = "unconstrained")) == held$n_parameters), cat("confint dimension", 
        dim(confint(held)), "\n"), stopifnot(nrow(confint(held)) == 
        held$n_parameters), cat("\nB grand-transform OPG invariance\n"), 
    set.seed(15052), G <- 70L, m <- 8L, g <- rep(seq_len(G), 

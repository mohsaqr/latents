+#' @noRd
+.mixture_class_scales <- function(classes, lines = TRUE) {
+  colours <- stats::setNames(rep_len(.gg_okabe_ito, length(classes)), classes)
+  scales <- list(
+    ggplot2::scale_colour_manual(values = colours),
+    ggplot2::scale_fill_manual(values = colours),

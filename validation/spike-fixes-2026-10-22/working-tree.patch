+# Excluded independent units must not change starting states or the internal
+# coordinate origin. Relative positive weights retain the established starts.
+
+test_that("zero-weight Gaussian outliers cannot consume a starting profile", {
+  set.seed(803)
+  active <- data.frame(y = c(rnorm(50, -3, 0.5), rnorm(50, 3, 0.5)), w = 1)
+  fit_at <- function(value) {
+    quietly(lpa(rbind(active, data.frame(y = value, w = 0)), "y", 2,
+                weights = "w", n_starts = 3, seed = 1))
+  }
+  reference <- fit_at(0)
+  vapply(c(1e4, 1e20), function(value) {
+    fitted <- fit_at(value)
+    expect_equal(fitted$log_likelihood, reference$log_likelihood, tolerance = 1e-12)
+    expect_identical(fitted$means, reference$means)
+    expect_identical(fitted$variances, reference$variances)
+    expect_equal(fitted$subject_posteriors[seq_len(nrow(active)), ],
+                 reference$subject_posteriors[seq_len(nrow(active)), ])
+    expect_equal(nrow(fitted$subject_posteriors), nrow(active) + 1L)
+    expect_equal(unname(rowSums(fitted$subject_posteriors)), rep(1, nrow(active) + 1L))
+    TRUE
+  }, logical(1))
+  expect_gt(diff(range(reference$means)), 5)
+})
+
+test_that("all start kinds use positive support for mixed and missing indicators", {
+  set.seed(107)
+  frame <- data.frame(a = rnorm(60), b = rnorm(60),
+                      category = factor(rep(c("a", "b", "c"), 20)),
+                      ordinal = ordered(rep(1:3, 20)), count = rpois(60, 3))
+  frame$a[c(2, 9)] <- NA
+  frame$b[c(3, 7)] <- NA
+  frame$category[c(1, 4)] <- NA
+  frame$ordinal[5] <- NA
+  frame$count[6] <- NA
+  x <- as.matrix(frame[c("a", "b")])
+  codes <- matrix(as.integer(frame$category), ncol = 1)
+  extra <- .latents_prepare_extra(frame, "ordinal", "count", "fiml")
+  extended_x <- rbind(c(1e20, -1e20), x, c(NA, 1e12))
+  extended_codes <- rbind(3L, codes, NA_integer_)
+  extended_frame <- frame[c(1, seq_len(nrow(frame)), 2), ]
+  extended_frame$count[c(1, nrow(extended_frame))] <- c(1e12, 0)
+  extended_extra <- .latents_prepare_extra(extended_frame, "ordinal", "count", "fiml")
+  groups <- rep(seq_len(15), each = 4)
+  extended_groups <- c(1L, groups + 1L, 17L)
+  vapply(c("ward", "kmeans", "partition", "centres"), function(kind) {
+    args <- list(n_profiles = 2, n_types = 2, variance_model = "varying",
+                 min_variance = 1e-6, start_index = 3,
+                 covariance_model = "full", n_categories = 3,
+                 hierarchical = identical(kind, "ward"),
+                 kind = if (identical(kind, "ward")) "kmeans" else kind)
+    set.seed(91)
+    reference <- do.call(.multilpa_initialize,
+                         c(list(x = x, group_index = groups, codes = codes,
+                                extra = extra), args))
+    reference_rng <- .Random.seed
+    set.seed(91)
+    fitted <- do.call(.multilpa_initialize,
+                      c(list(x = extended_x, group_index = extended_groups,
+                             codes = extended_codes, extra = extended_extra,
+                             row_weights = c(0, rep(c(1, 2), 30), 0)), args))
+    expect_identical(fitted, reference)
+    expect_identical(.Random.seed, reference_rng)
+    TRUE
+  }, logical(1))
+})
+
+test_that("all-positive weights leave initialization and its RNG unchanged", {
+  set.seed(118)
+  x <- matrix(rnorm(120), 60, 2)
+  initialize <- function(weights) {
+    .multilpa_initialize(x, rep(seq_len(15), each = 4), 2, 2, "varying",
+                         1e-6, 3, row_weights = weights)
+  }
+  set.seed(76)
+  plain <- initialize(NULL)
+  plain_rng <- .Random.seed
+  set.seed(76)
+  expect_identical(initialize(rep(c(0.5, 2), 30)), plain)
+  expect_identical(.Random.seed, plain_rng)
+  expect_identical(.multilpa_initialization_center(x), colMeans(x))
+  expect_identical(.multilpa_initialization_center(x, rep(1, nrow(x))), colMeans(x))
+})
+
+test_that("excluded groups retain the full observation and group layout", {
+  set.seed(223)
+  active <- data.frame(id = rep(seq_len(20), each = 4),
+                        a = rnorm(80, rep(c(-3, 3), 40), 0.6),
+                        b = rnorm(80, rep(c(-2, 2), 40), 0.6), w = 1)
+  fit_at <- function(value) {
+    data <- rbind(data.frame(id = 0, a = value, b = -value, w = 0), active)
+    quietly(multilpa(data, c("a", "b"), "id", 2, 2,
+                     weights = "w", n_starts = 3, max_iter = 20, seed = 7))
+  }
+  reference <- fit_at(0)
+  fitted <- fit_at(1e20)
+  expect_identical(fitted$means, reference$means)
+  expect_identical(fitted$variances, reference$variances)
+  expect_equal(fitted$log_likelihood, reference$log_likelihood, tolerance = 1e-12)
+  expect_equal(nrow(fitted$subject_posteriors), 81L)
+  expect_equal(nrow(fitted$group_posteriors), 21L)
+  expect_equal(unname(rowSums(fitted$group_posteriors)), rep(1, 21))
+})
+
+test_that("covariate and transition starts exclude zero-weight indicator outliers", {
+  set.seed(304)
+  active <- data.frame(id = rep(seq_len(30), each = 2), time = rep(1:2, 30),
+                        y = rnorm(60, rep(c(-3, 3), each = 30), 0.6),
+                        z = rnorm(60), w = 1)
+  extend <- function(value) {
+    rbind(active, data.frame(id = 31, time = 1:2,
+                             y = c(value, -value), z = c(0, 1), w = 0))
+  }
+  cov_fit <- function(value) {
+    quietly(lpa(extend(value), "y", 2, profile_covariates = "z", weights = "w",
+                n_starts = 3, max_iter = 0, seed = 5))
+  }
+  reference <- cov_fit(0)
+  fitted <- cov_fit(1e20)
+  expect_identical(fitted$means, reference$means)
+  expect_identical(fitted$variances, reference$variances)
+  expect_equal(fitted$log_likelihood, reference$log_likelihood, tolerance = 1e-12)
+  transition_fit <- function(value) {
+    quietly(lta(extend(value), "y", "id", 2, time = "time",
+                                n_group_classes = 1, weights = "w",
+                                n_starts = 3, max_iter = 0, seed = 5))
+  }
+  reference <- transition_fit(0)
+  fitted <- transition_fit(1e20)
+  expect_identical(fitted$means, reference$means)
+  expect_identical(fitted$variances, reference$variances)
+  expect_equal(fitted$log_likelihood, reference$log_likelihood, tolerance = 1e-12)
+  expect_equal(nrow(fitted$group_posteriors), 31L)
+})
+
+test_that("insufficient positive-weight indicator support fails clearly", {
+  data <- data.frame(y = c(NA_real_, NA_real_, 2, 3), z = 0:3, w = c(1, 1, 0, 0))
+  expect_error(quietly(lpa(data, c("y", "z"), 1, weights = "w", missing = "fiml")),
+                "observed row with positive", class = "latents_bad_data")
+  data <- data.frame(y = c(1, 1, 4), w = c(1, 1, 0))
+  expect_error(quietly(lpa(data, "y", 2, weights = "w", n_starts = 1)),
+                "distinct observed indicator.*positive sampling weight",
+                class = "latents_all_starts_failed")
+})
diff --git a/tests/testthat/test-lta-covariance-boundary.R b/tests/testthat/test-lta-covariance-boundary.R
new file mode 100644
index 0000000..d0f6e0d
--- /dev/null
+++ b/tests/testthat/test-lta-covariance-boundary.R
@@ -0,0 +1,78 @@
+#' Generate Gaussian transition data with a controlled covariance geometry
+#' @param geometry A flat covariance, narrow marginal, or interior covariance.
+#' @return A three-occasion data frame with two well-separated profiles.
+lta_covariance_boundary_data <- function(geometry) {
+  stopifnot(geometry %in% c("flat", "narrow", "interior"))
+  set.seed(12)
+  n <- 180L
+  location <- sample(c(-5, 5), n, replace = TRUE)
+  z <- rnorm(n)
+  noise <- rnorm(n)
+  data.frame(
+    id = rep(seq_len(n / 3L), each = 3L), time = rep(seq_len(3L), n / 3L),
+    a = location + if (geometry == "narrow") .03 * z else z,
+    b = location + if (geometry == "flat") z + .03 * noise else noise)
+}
+
+test_that("general LTA detects a full covariance eigenvalue at its lower bound", {
+  data <- lta_covariance_boundary_data("flat")
+  invisible(lapply(c("invariant", "occasion"), function(measurement) {
+    expect_warning(fit <- lta(
+      data, c("a", "b"), "id", 2, time = "time", model = "VVV",
+      transitions = "occasion", measurement = measurement,
+      n_starts = 1, seed = 1, max_iter = 300, min_variance = .01),
+      class = "latents_boundary")
+    expect_true(fit$converged)
+    expect_false(fit$probability_boundary)
+    expect_true(fit$boundary)
+    expect_length(fit$measurement, if (measurement == "occasion") 3L else 1L)
+    invisible(lapply(fit$measurement, function(block) {
+      # Marginal variances are interior; only the correlated direction is bound.
+      expect_gt(min(block$variances), .1)
+      eigenvalues <- apply(block$covariances, 3L, function(covariance) {
+        min(eigen(covariance, symmetric = TRUE, only.values = TRUE)$values)
+      })
+      expect_equal(unname(eigenvalues), rep(.01, 2L), tolerance = 1e-10)
+    }))
+    expect_error(parameter_inference(fit), class = "latents_boundary_fit")
+    expect_error(vcov(fit), class = "latents_boundary_fit")
+  }))
+})
+
+test_that("general LTA retains diagonal variance boundary protection", {
+  data <- lta_covariance_boundary_data("narrow")
+  invisible(lapply(c("invariant", "occasion"), function(measurement) {
+    expect_warning(fit <- lta(
+      data, c("a", "b"), "id", 2, time = "time", model = "VVI",
+      transitions = "occasion", measurement = measurement,
+      n_starts = 1, seed = 1, max_iter = 300, min_variance = .01),
+      class = "latents_boundary")
+    expect_true(fit$converged)
+    expect_false(fit$probability_boundary)
+    expect_true(fit$boundary)
+    invisible(lapply(fit$measurement, function(block) {
+      expect_null(block$covariances)
+      expect_equal(unname(block$variances[, 1L]), rep(.01, 2L), tolerance = 1e-10)
+    }))
+    expect_error(parameter_inference(fit), class = "latents_boundary_fit")
+  }))
+})
+
+test_that("general LTA interior full covariances are not flagged as bound", {
+  data <- lta_covariance_boundary_data("interior")
+  invisible(lapply(c("invariant", "occasion"), function(measurement) {
+    expect_no_warning(fit <- lta(
+      data, c("a", "b"), "id", 2, time = "time", model = "VVV",
+      transitions = "occasion", measurement = measurement,
+      n_starts = 1, seed = 1, max_iter = 300, min_variance = .01))
+    expect_true(fit$converged)
+    expect_false(fit$probability_boundary)
+    expect_false(fit$boundary)
+    invisible(lapply(fit$measurement, function(block) {
+      eigenvalues <- apply(block$covariances, 3L, function(covariance) {
+        min(eigen(covariance, symmetric = TRUE, only.values = TRUE)$values)
+      })
+      expect_gt(min(eigenvalues), .1)
+    }))
+  }))
+})
diff --git a/tests/testthat/test-cross-level-thin-profiles.R b/tests/testthat/test-cross-level-thin-profiles.R
new file mode 100644
index 0000000..b6e2455
--- /dev/null
+++ b/tests/testthat/test-cross-level-thin-profiles.R
@@ -0,0 +1,164 @@
+# The cross-level likelihood has two Gaussian measurement blocks; each is
+# checked using the normalized sampling weights used by its own M-step.
+
+#' Capture cross-level warnings without hiding unrelated condition classes
+#' @param ... Arguments passed to multilpa().
+#' @return The fitted model and its warning conditions.
+cross_level_capture_warnings <- function(...) {
+  notices <- list()
+  fit <- withCallingHandlers(multilpa(...), warning = function(notice) {
+    notices[[length(notices) + 1L]] <<- notice
+    invokeRestart("muffleWarning")
+  })
+  list(fit = fit, warnings = notices)
+}
+
+#' Separate a few groups at both Gaussian levels
+#' @param n_small Number of separated groups.
+#' @param group_sizes Number of ratings per group.
+#' @return A data frame with a group ID and two Gaussian indicators.
+cross_level_thin_data <- function(n_small = 3L, group_sizes = rep(2L, 40L)) {
+  stopifnot(n_small > 0L, n_small < length(group_sizes), all(group_sizes > 0L))
+  set.seed(7)
+  data <- data.frame(g = rep(seq_along(group_sizes), group_sizes),
+                     a = stats::rnorm(sum(group_sizes)),
+                     b = stats::rnorm(sum(group_sizes)))
+  data[data$g <= n_small, c("a", "b")] <-
+    data[data$g <= n_small, c("a", "b")] + 20
+  data$w <- ifelse(data$g <= n_small, 0.01, 1)
+  data
+}
+
+#' Keep only thin-profile conditions for their separate assertions
+#' @param captured Result of cross_level_capture_warnings().
+#' @return The thin-profile warning conditions.
+cross_level_thin_notices <- function(captured) {
+  Filter(function(notice) inherits(notice, "latents_thin_profiles"), captured$warnings)
+}
+
+test_that("cross-level profile support restores normalized sampling weights", {
+  data <- cross_level_thin_data()
+  invisible(lapply(c("full_cross_level", "restricted_cross_level"), function(family) {
+    captured <- cross_level_capture_warnings(
+      data, c("a", "b"), "g", 2L, 1L, family = family, weights = "w",
+      n_starts = 1L, seed = 1, max_iter = 300L)
+    fit <- captured$fit
+    notices <- cross_level_thin_notices(captured)
+    expect_true(fit$converged)
+    expect_false(fit$boundary)
+    expect_length(notices, 1L)
+    expect_match(conditionMessage(notices[[1L]]), "at the individual level")
+    expect_gt(min(colSums(fit$subject_posteriors)), 4)
+    weights <- unname(fit$sampling_weights[fit$sufficient_statistics$index])
+    expect_lt(min(colSums(fit$subject_posteriors * weights)), 1)
+    expect_equal(rowSums(fit$subject_posteriors), rep(1, nrow(data)))
+    expect_equal(unname(fit$group_posteriors), matrix(1, 40L, 1L))
+  }))
+})
+
+test_that("cross-level group Gaussian mixtures are checked exactly once", {
+  data <- cross_level_thin_data(group_sizes = rep(3L, 40L))
+  invisible(lapply(c("full_cross_level", "restricted_cross_level"), function(family) {
+    captured <- cross_level_capture_warnings(
+      data, c("a", "b"), "g", 1L, 2L, family = family,
+      between_variance = "varying", n_starts = 1L, seed = 1, max_iter = 300L)
+    fit <- captured$fit
+    notices <- cross_level_thin_notices(captured)
+    expect_true(fit$converged)
+    expect_false(fit$boundary)
+    expect_length(notices, 1L)
+    expect_match(conditionMessage(notices[[1L]]), "at the group level \\(group classes\\)")
+    expect_equal(sort(unname(colSums(fit$group_posteriors))), c(3, 37))
+    expect_equal(unname(fit$subject_posteriors), matrix(1, nrow(data), 1L))
+  }))
+})
+
+test_that("cross-level group support also restores sampling weights", {
+  data <- cross_level_thin_data(n_small = 6L)
+  captured <- cross_level_capture_warnings(
+    data, c("a", "b"), "g", 1L, 2L, family = "full_cross_level", weights = "w",
+    n_starts = 1L, seed = 1, max_iter = 300L)
+  fit <- captured$fit
+  notices <- cross_level_thin_notices(captured)
+  expect_true(fit$converged)
+  expect_length(notices, 1L)
+  expect_match(conditionMessage(notices[[1L]]), "at the group level")
+  expect_gt(min(colSums(fit$group_posteriors)), 4)
+  expect_lt(min(colSums(fit$group_posteriors * fit$sampling_weights)), 1)
+})
+
+test_that("shared cross-level spreads do not raise a thin-profile notice", {
+  data <- cross_level_thin_data(group_sizes = rep(3L, 40L))
+  invisible(lapply(c("full_cross_level", "restricted_cross_level"), function(family) {
+    captured <- cross_level_capture_warnings(
+      data, c("a", "b"), "g", 2L, 2L, family = family,
+      variance_model = "equal", between_variance = "equal",
+      n_starts = 1L, seed = 1, max_iter = 300L)
+    expect_true(captured$fit$converged)
+    expect_length(cross_level_thin_notices(captured), 0L)
+  }))
+})
+
+test_that("restricted support uses each factor's own weight normalization", {
+  data <- cross_level_thin_data(group_sizes = c(rep(10L, 3L), rep(2L, 37L)))
+  captured <- cross_level_capture_warnings(
+    data, c("a", "b"), "g", 2L, 1L, family = "restricted_cross_level", weights = "w",
+    n_starts = 1L, seed = 1, max_iter = 300L)
+  fit <- captured$fit
+  individual <- fit$gaussian_diagnostics[
+    fit$gaussian_diagnostics$context == "individual profiles", , drop = FALSE]
+  group <- fit$gaussian_diagnostics[
+    fit$gaussian_diagnostics$context == "group classes", , drop = FALSE]
+  raw_weights <- data$w
+  normalized_weights <- raw_weights * (nrow(data) / sum(raw_weights))
+  expect_equal(unname(individual$gaussian_mass),
+               unname(colSums(fit$subject_posteriors * normalized_weights)))
+  expect_equal(sum(individual$gaussian_mass), nrow(data))
+  expect_equal(unname(group$gaussian_mass), 40)
+  expect_length(cross_level_thin_notices(captured), 1L)
+})
+
+test_that("excluded groups do not determine full cross-level starts", {
+  data <- cross_level_thin_data(n_small = 15L)
+  data$w <- 1
+  data$w[data$g == 40L] <- 0
+  far <- data
+  far[far$g == 40L, c("a", "b")] <- 1e20
+  baseline <- cross_level_capture_warnings(
+    data, c("a", "b"), "g", 1L, 2L, family = "full_cross_level", weights = "w",
+    n_starts = 2L, seed = 1, max_iter = 300L)$fit
+  rng <- .Random.seed
+  moved <- cross_level_capture_warnings(
+    far, c("a", "b"), "g", 1L, 2L, family = "full_cross_level", weights = "w",
+    n_starts = 2L, seed = 1, max_iter = 300L)$fit
+  expect_true(baseline$converged)
+  expect_true(moved$converged)
+  expect_identical(.Random.seed, rng)
+  fields <- c("profile_means", "profile_variances", "composition", "group_means",
+              "group_mean_variances", "group_probabilities", "log_likelihood", "starts")
+  expect_identical(moved[fields], baseline[fields])
+  expect_equal(unname(rowSums(moved$group_posteriors)), rep(1, 40L))
+})
+
+test_that("excluded groups cannot conceal constant or insufficient positive support", {
+  data <- cross_level_thin_data(n_small = 15L)
+  data$a <- 0
+  data$w <- 1
+  data$w[data$g == 40L] <- 0
+  data$a[data$g == 40L] <- 1e4
+  captured <- cross_level_capture_warnings(
+    data, c("a", "b"), "g", 2L, 1L, family = "full_cross_level", weights = "w",
+    n_starts = 1L, seed = 1, max_iter = 300L)
+  expect_true(captured$fit$converged)
+  expect_true(captured$fit$boundary)
+  expect_equal(unname(captured$fit$profile_means[, "a"]), c(0, 0))
+  expect_equal(unname(captured$fit$profile_variances[, "a"]), rep(1e-6, 2L))
+  data <- data.frame(g = rep(1:3, each = 2L),
+                     a = c(0, 0, 0, 0, 3, 4),
+                     b = c(0, 0, 0, 0, 3, 4), w = c(1, 1, 1, 1, 0, 0))
+  expect_error(multilpa(data, c("a", "b"), "g", 2L, 1L,
+                        family = "full_cross_level", weights = "w",
+                        n_starts = 1L, seed = 1),
+                "distinct observed indicator.*positive sampling weight",
+                class = "latents_all_starts_failed")
+})
diff --git a/tests/testthat/test-gaussian-diagnostics.R b/tests/testthat/test-gaussian-diagnostics.R
new file mode 100644
index 0000000..fac4b2a
--- /dev/null
+++ b/tests/testthat/test-gaussian-diagnostics.R
@@ -0,0 +1,138 @@
+#' Build a known-variance Gaussian diagnostic fixture
+#' @return Data, posteriors and two full-rank Gaussian parameter blocks.
+gaussian_diagnostics_fixture <- function() {
+  data <- rbind(c(-1, -1), c(-1, 1), c(1, -1), c(1, 1))
+  parameters <- list(
+    means = matrix(0, 2L, 2L),
+    variances = matrix(1, 2L, 2L,
+      dimnames = list(c("flat", "regular"), c("a", "b"))),
+    covariances = array(c(matrix(c(1, .999, .999, 1), 2L), diag(2L)),
+                        c(2L, 2L, 2L)))
+  list(data = data, posteriors = matrix(rep(c(.3, .7), each = 4L), 4L),
+       parameters = parameters)
+}
+
+test_that("Gaussian diagnostics describe a flat direction with moderate support", {
+  fixture <- gaussian_diagnostics_fixture()
+  parameters_before <- fixture$parameters
+  rows <- rep(seq_len(4L), 20L)
+  result <- .latents_gaussian_diagnostics(
+    fixture$parameters, fixture$data[rows, ], fixture$posteriors[rows, ],
+    context = "occasion 2")
+  expect_equal(result$profile, c("flat", "regular"))
+  expect_equal(result$context, rep("occasion 2", 2L))
+  expect_equal(result$gaussian_mass, c(24, 56))
+  expect_equal(result$positive_rows, rep(80L, 2L))
+  expect_equal(result$weight_effective_n, rep(80, 2L))
+  expect_equal(result$min_variance_ratio, c(1, 1))
+  expect_equal(result$min_standardized_eigenvalue, c(.001, 1), tolerance = 1e-12)
+  expect_false(any(result$boundary))
+  expect_identical(fixture$parameters, parameters_before)
+})
+
+test_that("standardized Gaussian ratios tolerate extreme changes of units", {
+  fixture <- gaussian_diagnostics_fixture()
+  reference <- .latents_gaussian_diagnostics(
+    fixture$parameters, fixture$data, fixture$posteriors)
+  scales <- list(c(10, .1), c(-2, 3), rep(1e100, 2L), rep(1e-100, 2L),
+                 c(1e100, 1e-100))
+  invisible(lapply(scales, function(scale) {
+    parameters <- fixture$parameters
+    parameters$means <- sweep(parameters$means, 2L, scale, "*")
+    parameters$variances <- sweep(parameters$variances, 2L, scale^2, "*")
+    parameters$covariances <- array(vapply(seq_len(2L), function(profile) {
+      parameters$covariances[, , profile] * outer(scale, scale)
+    }, matrix(0, 2L, 2L)), c(2L, 2L, 2L))
+    result <- .latents_gaussian_diagnostics(
+      parameters, sweep(fixture$data, 2L, scale, "*"), fixture$posteriors)
+    # The absolute lower-bound flag deliberately depends on the chosen units.
+    columns <- c("gaussian_mass", "positive_rows", "weight_effective_n",
+                 "min_variance_ratio", "min_standardized_eigenvalue")
+    expect_equal(result[columns], reference[columns], tolerance = 1e-12)
+  }))
+})
+
+test_that("tiny positive posterior mass does not imply a singular covariance", {
+  fixture <- gaussian_diagnostics_fixture()
+  fixture$parameters$covariances[, , 1L] <- diag(2L)
+  posteriors <- matrix(rep(c(1e-12, 1 - 1e-12), each = 4L), 4L)
+  result <- .latents_gaussian_diagnostics(
+    fixture$parameters, fixture$data, posteriors)
+  expect_equal(result$gaussian_mass[1L], 4e-12, tolerance = 1e-15)
+  expect_equal(result$weight_effective_n, rep(4, 2L))
+  expect_equal(result$positive_rows, rep(4L, 2L))
+  expect_equal(result$min_standardized_eigenvalue, c(1, 1))
+  expect_false(any(result$boundary))
+})
+
+test_that("normalized Gaussian mass and weight effective n remain distinct", {
+  fixture <- gaussian_diagnostics_fixture()
+  reference <- .latents_gaussian_diagnostics(
+    fixture$parameters, fixture$data, fixture$posteriors, weights = rep(1, 4L),
+    context = "individual profiles")
+  # Normalizing to all eight units doubles active weights. Excluded extreme
+  # rows cannot supply Gaussian support, change ratios, or change Kish n.
+  appended <- .latents_gaussian_diagnostics(
+    fixture$parameters,
+    rbind(fixture$data, matrix(rep(c(1e100, -1e100), each = 4L), 4L)),
+    rbind(fixture$posteriors, fixture$posteriors),
+    weights = c(rep(2, 4L), rep(0, 4L)), context = "individual profiles")
+  expect_equal(appended$gaussian_mass, reference$gaussian_mass * 2)
+  expect_equal(appended$positive_rows, reference$positive_rows)
+  expect_equal(appended$weight_effective_n, reference$weight_effective_n)
+  expect_equal(appended$min_variance_ratio, reference$min_variance_ratio)
+  expect_equal(appended$min_standardized_eigenvalue,
+               reference$min_standardized_eigenvalue)
+  expect_equal(appended$context, reference$context)
+})
+
+test_that("Gaussian diagnostics mask missing rows but retain partial observations", {
+  fixture <- gaussian_diagnostics_fixture()
+  data <- fixture$data
+  data[1L, ] <- NA_real_
+  data[2L, 2L] <- NA_real_
+  data[3L, 1L] <- NA_real_
+  result <- .latents_gaussian_diagnostics(
+    fixture$parameters, data, fixture$posteriors, weights = c(5, 1, 2, 3))
+  expect_equal(result$gaussian_mass, c(1.8, 4.2))
+  expect_equal(result$positive_rows, rep(3L, 2L))
+  expect_equal(result$weight_effective_n, rep(36 / 14, 2L))
+  expect_equal(result$min_variance_ratio, rep(1 / .96, 2L))
+  no_gaussian <- .latents_gaussian_diagnostics(
+    list(), matrix(numeric(), 4L, 0L), fixture$posteriors,
+    context = "categorical only")
+  expect_s3_class(no_gaussian, "data.frame")
+  expect_equal(nrow(no_gaussian), 0L)
+  expect_identical(names(no_gaussian), names(result))
+})
+
+test_that("Gaussian diagnostics report unavailable reference variation explicitly", {
+  fixture <- gaussian_diagnostics_fixture()
+  fixture$data[, 2L] <- NA_real_
+  result <- .latents_gaussian_diagnostics(
+    fixture$parameters, fixture$data, fixture$posteriors)
+  expect_true(all(is.na(result$min_variance_ratio)))
+  expect_true(all(is.na(result$min_standardized_eigenvalue)))
+  expect_equal(result$gaussian_mass, c(1.2, 2.8))
+  expect_output(.latents_print_gaussian_diagnostics(result),
+                "insufficient observed reference variation")
+  expect_output(.latents_print_gaussian_diagnostics(NULL), NA)
+})
+
+test_that("Gaussian diagnostic labels identify the component and density context", {
+  fixture <- gaussian_diagnostics_fixture()
+  individual <- .latents_gaussian_diagnostics(
+    fixture$parameters, fixture$data, fixture$posteriors,
+    context = "individual profiles")
+  group <- .latents_gaussian_diagnostics(
+    fixture$parameters, fixture$data, fixture$posteriors,
+    context = "group classes")
+  expect_equal(individual$profile, group$profile)
+  expect_equal(group$context, rep("group classes", 2L))
+  expect_output(.latents_print_gaussian_diagnostics(group),
+                "0.001 \\(group classes, flat\\)")
+  rownames(fixture$parameters$variances) <- NULL
+  unnamed <- .latents_gaussian_diagnostics(
+    fixture$parameters, fixture$data, fixture$posteriors)
+  expect_equal(unnamed$profile, c("profile_1", "profile_2"))
+})
diff --git a/tests/testthat/test-gaussian-diagnostic-tables.R b/tests/testthat/test-gaussian-diagnostic-tables.R
new file mode 100644
index 0000000..90a6132
--- /dev/null
+++ b/tests/testthat/test-gaussian-diagnostic-tables.R
@@ -0,0 +1,166 @@
+#' A small separated Gaussian panel for public diagnostic-table checks
+#' @return Group IDs, occasions, a covariate and two continuous indicators.
+gaussian_table_data <- function() {
+  set.seed(3)
+  n <- 90L
+  location <- rep(c(-2, 2), each = n / 2L)
+  data.frame(id = rep(seq_len(n / 3L), each = 3L), time = rep(seq_len(3L), n / 3L),
+             a = rnorm(n) + location, b = rnorm(n) + location, z = rnorm(n))
+}
+
+test_that("ordinary and covariate fits expose the same Gaussian table in summaries", {
+  data <- gaussian_table_data()
+  fits <- list(
+    lpa(data, c("a", "b"), 2L, n_starts = 1L, seed = 1),
+    lpa(data, c("a", "b"), 2L, profile_covariates = "z", n_starts = 1L, seed = 1))
+  invisible(lapply(fits, function(fit) {
+    table <- get_results(fit, "gaussian_diagnostics")
+    expect_identical(table, fit$gaussian_diagnostics)
+    expect_identical(get_results(summary(fit), "gaussian_diagnostics"), table)
+    expect_equal(table$context, rep("profiles", 2L))
+    expect_equal(table$profile, paste0("profile_", seq_len(2L)))
+    expect_equal(table$gaussian_mass, unname(colSums(fit$subject_posteriors)))
+    reference_variance <- vapply(data[c("a", "b")], function(x) mean((x - mean(x))^2),
+                                 numeric(1))
+    expected <- apply(sweep(fit$variances, 2L, reference_variance, "/"), 1L, min)
+    expect_equal(table$min_standardized_eigenvalue, unname(expected))
+    expect_output(print(fit), "Smallest standardized Gaussian eigenvalue")
+    legacy <- fit
+    legacy$gaussian_diagnostics <- NULL
+    expect_false(any(grepl("Smallest standardized Gaussian eigenvalue",
+                           capture.output(print(legacy)), fixed = TRUE)))
+  }))
+})
+
+test_that("homogeneous and general LTA Gaussian diagnostics follow measurement occasions", {
+  data <- gaussian_table_data()
+  shared <- lta(data, c("a", "b"), "id", 2L, time = "time", n_starts = 1L, seed = 1)
+  occasion <- quietly(lta(
+    data, c("a", "b"), "id", 2L, time = "time", transitions = "occasion",
+    measurement = "occasion", n_starts = 1L, seed = 1, max_iter = 0L),
+    "latents_unconverged")
+  shared_table <- get_results(shared, "gaussian_diagnostics")
+  expect_identical(shared_table, shared$gaussian_diagnostics)
+  expect_identical(get_results(suppressMessages(summary(shared)), "gaussian_diagnostics"),
+                   shared_table)
+  expect_equal(shared_table$context, rep("profiles", 2L))
+  expect_equal(shared_table$gaussian_mass, unname(colSums(shared$subject_posteriors)))
+  occasion_table <- get_results(occasion, "gaussian_diagnostics")
+  expect_identical(occasion_table, occasion$gaussian_diagnostics)
+  # General LTA summaries are named table lists, rather than summary objects.
+  expect_identical(suppressMessages(summary(occasion))$gaussian_diagnostics, occasion_table)
+  expect_equal(occasion_table$context, rep(paste("occasion", 1:3), each = 2L))
+  expect_equal(occasion_table$profile, rep(paste0("profile_", 1:2), 3L))
+  invisible(lapply(seq_len(3L), function(time) {
+    rows <- data$time == time
+    index <- occasion_table$context == paste("occasion", time)
+    expect_equal(occasion_table$gaussian_mass[index],
+                 unname(colSums(occasion$subject_posteriors[rows, ])))
+    variances <- vapply(data[rows, c("a", "b")], function(x) mean((x - mean(x))^2),
+                        numeric(1))
+    expected <- apply(sweep(occasion$measurement[[time]]$variances, 2L, variances, "/"),
+                      1L, min)
+    expect_equal(occasion_table$min_standardized_eigenvalue[index], unname(expected))
+  }))
+  expect_output(print(shared), "Smallest standardized Gaussian eigenvalue")
+  expect_output(print(occasion), "Smallest standardized Gaussian eigenvalue")
+})
+
+test_that("weighted Gaussian tables use observed support and weighted reference variances", {
+  data <- gaussian_table_data()
+  data$weight <- rep(c(.25, 1, 2), 30L)
+  data$a[1L] <- NA_real_
+  data$b[2L] <- NA_real_
+  data[3L, c("a", "b")] <- NA_real_
+  weights <- data$weight * nrow(data) / sum(data$weight)
+  observed <- rowSums(!is.na(data[c("a", "b")])) > 0L
+  reference_variance <- vapply(data[c("a", "b")], function(values) {
+    available <- !is.na(values)
+    center <- sum(values[available] * weights[available]) / sum(weights[available])
+    sum(weights[available] * (values[available] - center)^2) / sum(weights[available])
+  }, numeric(1))
+  invisible(lapply(c(FALSE, TRUE), function(covariate) {
+    fit <- lpa(data, c("a", "b"), 2L, weights = "weight", missing = "fiml",
+               profile_covariates = if (covariate) "z" else character(),
+               n_starts = 1L, seed = 1L)
+    table <- get_results(fit, "gaussian_diagnostics")
+    contributions <- fit$subject_posteriors * weights * observed
+    expect_equal(table$gaussian_mass, unname(colSums(contributions)))
+    expect_equal(table$weight_effective_n,
+                 unname(colSums(contributions)^2 / colSums(contributions^2)))
+    expected <- apply(sweep(fit$variances, 2L, reference_variance, "/"), 1L, min)
+    expect_equal(table$min_standardized_eigenvalue, unname(expected))
+    expect_equal(table$positive_rows, unname(colSums(contributions > 0)))
+  }))
+})
+
+test_that("cross-level tables distinguish individual and group Gaussian densities", {
+  data <- gaussian_table_data()
+  invisible(lapply(c("full_cross_level", "restricted_cross_level"), function(family) {
+    fit <- quietly(multilpa(
+      data, c("a", "b"), "id", 2L, 2L, family = family,
+      between_variance = "varying", n_starts = 1L, seed = 1L, max_iter = 0L),
+      "latents_unconverged")
+    table <- get_results(fit, "gaussian_diagnostics")
+    expect_identical(table, fit$gaussian_diagnostics)
+    expect_identical(summary(fit)$gaussian_diagnostics, table)
+    expect_equal(table$context, rep(c("individual profiles", "group classes"), each = 2L))
+    individual <- table$context == "individual profiles"
+    group <- table$context == "group classes"
+    expect_equal(table$gaussian_mass[individual], unname(colSums(fit$subject_posteriors)))
+    expect_equal(table$gaussian_mass[group], unname(colSums(fit$group_posteriors)))
+    expect_equal(table$profile[individual], rownames(fit$profile_variances))
+    expect_equal(table$profile[group], rownames(fit$group_mean_variances))
+    expect_output(print(fit), "Smallest standardized Gaussian eigenvalue")
+  }))
+})
+
+test_that("moderate flat components remain visible without a new selection threshold", {
+  expect_no_warning(fit <- lpa(srl, names(srl), 4L, model = "VVV", seed = 1))
+  table <- get_results(fit, "gaussian_diagnostics")
+  expect_true(fit$converged)
+  expect_false(fit$boundary)
+  expect_gt(min(table$gaussian_mass), 20)
+  expect_lt(min(table$min_standardized_eigenvalue), .002)
+  expect_gt(min(table$min_standardized_eigenvalue), .001)
+  expect_output(print(fit), "Smallest standardized Gaussian eigenvalue: 0.001")
+  expect_equal(fit$log_likelihood, max(fit$starts$log_likelihood, na.rm = TRUE),
+               tolerance = 1e-6)
+})
+
+test_that("categorical models and old objects have no invented Gaussian diagnostics", {
+  data <- gaussian_table_data()
+  data$c <- factor(ifelse(data$a > 0, "high", "low"))
+  data$d <- factor(ifelse(data$b > 0, "high", "low"))
+  fits <- list(
+    quietly(lpa(data, c("c", "d"), 2L, categorical = c("c", "d"),
+                 n_starts = 1L, seed = 1L, max_iter = 0L), "latents_unconverged"),
+    quietly(lta(data, c("c", "d"), "id", 2L, categorical = c("c", "d"),
+                 time = "time", transitions = "occasion", n_starts = 1L,
+                 seed = 1L, max_iter = 0L), "latents_unconverged"))
+  invisible(lapply(fits, function(fit) {
+    expect_equal(nrow(fit$gaussian_diagnostics), 0L)
+    expect_false("gaussian_diagnostics" %in% names(suppressMessages(get_results(fit, "all"))))
+    expect_false(any(grepl("Smallest standardized Gaussian eigenvalue",
+                           capture.output(print(fit)), fixed = TRUE)))
+    expect_true(is.na(.latents_gaussian_minimum(fit, "min_standardized_eigenvalue")))
+  }))
+  legacy <- fits[[1L]]
+  legacy$gaussian_diagnostics <- NULL
+  expect_true(is.na(.latents_gaussian_minimum(legacy, "gaussian_mass")))
+})
+
+test_that("enumeration exposes continuous minima from the returned Gaussian fits", {
+  data <- gaussian_table_data()
+  grid <- enumerate_lpa(data, c("a", "b"), n_profiles = 1:2, model = "VVI",
+                        n_starts = 1L, seed = 1L)
+  expect_true(all(c("min_standardized_eigenvalue", "min_gaussian_mass") %in%
+                    names(grid$table)))
+  expected_eigenvalue <- vapply(grid$fits, function(fit) {
+    min(fit$gaussian_diagnostics$min_standardized_eigenvalue)
+  }, numeric(1))
+  expected_mass <- vapply(grid$fits, function(fit) min(fit$gaussian_diagnostics$gaussian_mass),
+                          numeric(1))
+  expect_equal(grid$table$min_standardized_eigenvalue, unname(expected_eigenvalue))
+  expect_equal(grid$table$min_gaussian_mass, unname(expected_mass))
+})
diff --git a/tests/testthat/test-gaussian-warning-support.R b/tests/testthat/test-gaussian-warning-support.R
new file mode 100644
index 0000000..b0e4998
--- /dev/null
+++ b/tests/testthat/test-gaussian-warning-support.R
@@ -0,0 +1,72 @@
+#' A small thin Gaussian profile with covariate and categorical columns
+#' @return An 80-row data frame with three clearly separated Gaussian rows.
+gaussian_warning_support_data <- function() {
+  set.seed(73)
+  data <- as.data.frame(matrix(rnorm(80L * 5L), 80L, 5L))
+  names(data) <- letters[seq_len(5L)]
+  data[seq_len(3L), ] <- data[seq_len(3L), ] + 10
+  data$z <- rnorm(80L)
+  data$categ <- c(rep("rare", 3L), rep("common", 77L))
+  data
+}
+
+#' Capture Gaussian-support warnings from a public fit
+#' @param expr A public fitting expression.
+#' @return The fit and its emitted thin-profile warning conditions.
+gaussian_warning_support_capture <- function(expr) {
+  warnings <- list()
+  fit <- withCallingHandlers(expr, warning = function(condition) {
+    if (inherits(condition, "latents_thin_profiles")) {
+      warnings[[length(warnings) + 1L]] <<- condition
+    }
+    if (inherits(condition, .multilpa_expected_warnings)) invokeRestart("muffleWarning")
+  })
+  list(fit = fit, thin = warnings)
+}
+
+test_that("retained empty rows cannot hide ordinary or covariate Gaussian warnings", {
+  data <- gaussian_warning_support_data()
+  empty <- data[rep(1L, 300L), ]
+  empty[, letters[seq_len(5L)]] <- NA_real_
+  # Covariates remain observed even when no measurement is present.
+  empty$z <- rep(c(-1, 1), 150L)
+  invisible(lapply(c(FALSE, TRUE), function(covariate) {
+    fit <- function(frame) gaussian_warning_support_capture(lpa(
+      frame, letters[seq_len(5L)], 2L,
+      profile_covariates = if (covariate) "z" else character(),
+      n_starts = 1L, seed = 1L, max_iter = 1000L,
+      missing = "fiml", drop_empty = FALSE))
+    original <- fit(data)
+    appended <- fit(rbind(data, empty))
+    expect_true(original$fit$converged)
+    expect_true(appended$fit$converged)
+    expect_length(original$thin, 1L)
+    expect_length(appended$thin, 1L)
+    expect_equal(min(original$fit$gaussian_diagnostics$gaussian_mass), 3, tolerance = 1e-7)
+    expect_equal(min(appended$fit$gaussian_diagnostics$gaussian_mass), 3, tolerance = 1e-7)
+    expect_gt(min(appended$fit$effective_profile_counts), 10)
+    expect_equal(appended$fit$gaussian_diagnostics$gaussian_mass,
+                 unname(colSums(appended$fit$subject_posteriors[seq_len(80L), ])))
+  }))
+})
+
+test_that("categorical-only rows cannot hide ordinary or covariate Gaussian warnings", {
+  data <- gaussian_warning_support_data()
+  categorical_only <- data[rep(1L, 300L), ]
+  categorical_only[, letters[seq_len(5L)]] <- NA_real_
+  categorical_only$z <- rep(c(-1, 1), 150L)
+  invisible(lapply(c(FALSE, TRUE), function(covariate) {
+    captured <- gaussian_warning_support_capture(lpa(
+      rbind(data, categorical_only), c(letters[seq_len(5L)], "categ"), 2L,
+      categorical = "categ", profile_covariates = if (covariate) "z" else character(),
+      n_starts = 1L, seed = 1L, max_iter = 1000L, missing = "fiml"))
+    fit <- captured$fit
+    expect_true(fit$converged)
+    expect_length(captured$thin, 1L)
+    expect_gt(min(fit$effective_profile_counts), 10)
+    expect_equal(min(fit$gaussian_diagnostics$gaussian_mass), 3, tolerance = 1e-7)
+    expect_equal(fit$gaussian_diagnostics$gaussian_mass,
+                 unname(colSums(fit$subject_posteriors[seq_len(80L), ])))
+    expect_true(all(fit$gaussian_diagnostics$positive_rows <= 80L))
+  }))
+})
diff --git a/tests/testthat/test-lta-thin-profiles.R b/tests/testthat/test-lta-thin-profiles.R
new file mode 100644
index 0000000..28d6415
--- /dev/null
+++ b/tests/testthat/test-lta-thin-profiles.R
@@ -0,0 +1,128 @@
+#' Capture thin-profile warnings from a fitted transition model
+#' @param expr A transition fitting expression.
+#' @return The fit and its thin-profile warning conditions.
+capture_lta_thin <- function(expr) {
+  thin <- list()
+  fit <- withCallingHandlers(expr, warning = function(condition) {
+    if (inherits(condition, "latents_thin_profiles")) {
+      thin[[length(thin) + 1L]] <<- condition
+    }
+    if (inherits(condition, .multilpa_expected_warnings)) invokeRestart("muffleWarning")
+  })
+  list(fit = fit, thin = thin)
+}
+
+#' Generate separated profiles at three irregular time values
+#' @param n_rare Number of rows in the rare profile.
+#' @return A data frame with grouping, time and two Gaussian indicators.
+lta_thin_data <- function(n_rare = 3L) {
+  stopifnot(n_rare > 0L, n_rare < 90L)
+  set.seed(1)
+  data.frame(g = rep(seq_len(30L), each = 3L),
+             t = rep(c(2, 4, 9), 30L),
+             a = c(rnorm(90L - n_rare), rnorm(n_rare, 20)),
+             b = c(rnorm(90L - n_rare), rnorm(n_rare, 20)))
+}
+
+test_that("empty LTA rows cannot hide thin Gaussian profiles under either empty policy", {
+  data <- lta_thin_data()
+  # A partly observed measurement still contributes to the density.
+  data$a[nrow(data)] <- NA_real_
+  empty <- data.frame(g = rep(31:130, each = 3L), t = rep(c(2, 4, 9), 100L),
+                      a = NA_real_, b = NA_real_)
+  invisible(lapply(c("homogeneous", "occasion"), function(transitions) {
+    invisible(lapply(c(TRUE, FALSE), function(drop_empty) {
+      fit <- function(frame) capture_lta_thin(lta(
+        frame, c("a", "b"), "g", 2, time = "t", missing = "fiml",
+        transitions = transitions, drop_empty = drop_empty,
+        n_starts = 1, seed = 1, max_iter = 500))
+      original <- fit(data)
+      appended <- fit(rbind(data, empty))
+      expect_length(original$thin, 1L)
+      expect_length(appended$thin, 1L)
+      expect_match(paste(vapply(appended$thin, conditionMessage, character(1)),
+                         collapse = " "), "3.0 Gaussian membership mass for 4")
+      expect_equal(sum(appended$fit$informative), 90L)
+      expect_gt(min(colSums(appended$fit$subject_posteriors)), 10)
+      expect_equal(appended$fit$log_likelihood, original$fit$log_likelihood,
+                   tolerance = 1e-7)
+    }))
+  }))
+})
+
+test_that("occasion Gaussian densities warn separately with occasion positions", {
+  data <- lta_thin_data(6L)
+  fit <- function(measurement) capture_lta_thin(lta(
+    data, c("a", "b"), "g", 2, time = "t", measurement = measurement,
+    transitions = "occasion", n_starts = 1, seed = 1, max_iter = 500))
+  occasion <- fit("occasion")
+  shared <- fit("invariant")
+  counts <- rowsum(occasion$fit$subject_posteriors, data$t)
+  expect_equal(unname(counts[, 2L]), rep(2, 3L), tolerance = 1e-8)
+  expect_length(occasion$thin, 3L)
+  messages <- vapply(occasion$thin, conditionMessage, character(1))
+  expect_true(all(vapply(seq_len(3L), function(label) {
+    any(grepl(sprintf("at occasion %s:", label), messages, fixed = TRUE))
+  }, logical(1))))
+  expect_length(shared$thin, 0L)
+})
+
+test_that("empty rows cannot inflate occasion-specific measurement support", {
+  data <- lta_thin_data(6L)
+  data$a[nrow(data)] <- NA_real_
+  empty <- data.frame(g = rep(31:130, each = 3L), t = rep(c(2, 4, 9), 100L),
+                      a = NA_real_, b = NA_real_)
+  invisible(lapply(c(TRUE, FALSE), function(drop_empty) {
+    result <- capture_lta_thin(lta(
+      rbind(data, empty), c("a", "b"), "g", 2, time = "t", missing = "fiml",
+      measurement = "occasion", drop_empty = drop_empty,
+      n_starts = 1, seed = 1, max_iter = 500))
+    expect_length(result$thin, 3L)
+    expect_true(all(grepl("2.0 Gaussian membership mass for 4",
+                         vapply(result$thin, conditionMessage, character(1)),
+                         fixed = TRUE)))
+    expect_equal(sum(result$fit$informative), 90L)
+  }))
+})
+
+test_that("LTA thin measurement warnings use scaled sampling memberships", {
+  invisible(lapply(c("invariant", "occasion"), function(measurement) {
+    # Nine raw rare memberships support a density, but their small weights do not.
+    data <- lta_thin_data(9L)
+    data$w <- ifelse(data$g >= 28L, 0.2, 1)
+    result <- capture_lta_thin(lta(
+      data, c("a", "b"), "g", 2, time = "t", weights = "w",
+      measurement = measurement, n_starts = 1, seed = 1, max_iter = 500))
+    weighted <- result$fit$subject_posteriors *
+      unname(result$fit$sampling_weights[as.character(data$g)])
+    expect_equal(min(colSums(result$fit$subject_posteriors)), 9, tolerance = 1e-7)
+    expect_lt(min(colSums(weighted)), 4)
+    expect_length(result$thin, if (measurement == "occasion") 3L else 1L)
+    # Conversely, a well-supported weighted profile must not warn merely
+    # because its unweighted membership is small.
+    data <- lta_thin_data()
+    data$w <- ifelse(data$g == 30L, 10, 1)
+    result <- capture_lta_thin(lta(
+      data, c("a", "b"), "g", 2, time = "t", weights = "w",
+      measurement = measurement, n_starts = 1, seed = 1, max_iter = 500))
+    expect_equal(min(colSums(result$fit$subject_posteriors)), 3, tolerance = 1e-7)
+    expect_length(result$thin, 0L)
+  }))
+})
+
+test_that("categorical-only LTA rows do not support a Gaussian density", {
+  data <- lta_thin_data(9L)
+  data$category <- factor(ifelse(data$g >= 28L, "rare", "common"))
+  data[data$g >= 29L, c("a", "b")] <- NA_real_
+  invisible(lapply(c("homogeneous", "occasion"), function(transitions) {
+    result <- capture_lta_thin(lta(
+      data, c("a", "b", "category"), "g", 2, time = "t",
+      categorical = "category", missing = "fiml", transitions = transitions,
+      n_starts = 1, seed = 1, max_iter = 500))
+    expect_gt(min(colSums(result$fit$subject_posteriors)), 8.9)
+    expect_true(all(result$fit$informative))
+    expect_length(result$thin, 1L)
+    expect_match(paste(vapply(result$thin, conditionMessage, character(1)),
+                       collapse = " "), "3.0 Gaussian membership mass for 4")
+  }))
+})
